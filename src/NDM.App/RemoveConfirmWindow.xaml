<Window x:Class="NDM.App.RemoveConfirmWindow" Style="{StaticResource {x:Type Window}}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:NDM.App.Localization"
        Title="{loc:T remove.title.remove_downloads}" Width="520" SizeToContent="Height" MinWidth="440" MinHeight="390" MaxHeight="640" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13">
  <Border Padding="24,22,24,20">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="72"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.Name="{loc:T remove.a11y.remove_confirmation_heading}"/>
      <TextBlock x:Name="Explain" Grid.Row="1" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,14"/>
      <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="ItemList" Margin="4" AutomationProperties.Name="{loc:T remove.a11y.items_to_remove}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="10,6">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                  <TextBlock Text="{Binding Detail}" FlowDirection="LeftToRight" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
      <CheckBox x:Name="DeleteFilesBox" Grid.Row="3" Margin="0,16,0,0" MinHeight="26" Foreground="{DynamicResource InkBrush}" VerticalContentAlignment="Center" Checked="DeleteFiles_Changed" Unchecked="DeleteFiles_Changed" Content="{loc:T remove.chk.also_delete_the_downloaded_file_s}"/>
      <TextBlock x:Name="DeleteWarning" Grid.Row="4" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="26,6,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
      <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
        <Button x:Name="CancelButton" Content="{loc:T common.btn.cancel_2}" IsCancel="True" MinWidth="96" MinHeight="32" Margin="0,0,8,0" Click="Cancel_Click"/>
        <Button x:Name="RemoveButton" Content="{loc:T remove.btn.remove}" MinWidth="96" MinHeight="32" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Remove_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
