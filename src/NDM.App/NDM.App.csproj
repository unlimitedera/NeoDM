<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NeoDM</AssemblyName><RootNamespace>NDM.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>Assets/NDM.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><RuntimeHostConfigurationOption Include="Switch.System.Windows.Controls.Text.UseAdornerForTextboxSelectionRendering" Value="false" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../NDM.Core/NDM.Core.csproj" /><Compile Remove="Tests/**/*.cs" /><Resource Include="Assets/NDM.ico" /><Resource Include="Assets/Guide/*.png" /></ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../NDM.Torrent/NDM.Torrent.csproj" />
    <EmbeddedResource Include="../../CHANGELOG.md" LogicalName="CHANGELOG.md" />
    <EmbeddedResource Include="Locales/*.json" LogicalName="Locales.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
