<UserControl x:Class="NDM.App.ExtensionNoticeBanner" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:NDM.App.Localization">
  <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="14,12">
    <StackPanel>
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{loc:T notice.a11y.browser_extension_version_notice}"/>
      <CheckBox x:Name="MuteBox" Content="{loc:T notice.chk.dont_remind_me_about_this_version}" Margin="0,10,0,0"/>
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <Button x:Name="GuideButton" Content="{loc:T notice.btn.show_install_guide}" Click="Guide_Click" MinWidth="130"/>
        <Button x:Name="DismissButton" Content="{loc:T notice.btn.dismiss}" Click="Dismiss_Click" MinWidth="84" Margin="8,0,0,0"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
