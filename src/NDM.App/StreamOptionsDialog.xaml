<Window Style="{StaticResource {x:Type Window}}" x:Class="NDM.App.StreamOptionsDialog" Icon="Assets/NDM.ico" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:NDM.App.Localization" xmlns:app="clr-namespace:NDM.App" Title="{loc:T stream.title}" Width="600" Height="700" MinHeight="460" MinWidth="520" WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,16,0">
      <TextBlock Text="{loc:T stream.heading}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="{loc:T stream.intro}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,16"/>
      <Label Content="{loc:T common.label.download_url}" Target="{Binding ElementName=UrlDisplay}" Foreground="{DynamicResource InkBrush}" Padding="0,0,0,6"/>
      <TextBox x:Name="UrlDisplay" app:SelectableText.Enabled="True" FlowDirection="LeftToRight" IsReadOnly="True" Background="{DynamicResource SidebarBrush}" AutomationProperties.Name="{loc:T common.a11y.download_url}"/>
      <TextBox x:Name="PrivateNetworkNotice" Style="{StaticResource SelectableText}" Text="{loc:T capture.warn.private_network}" Foreground="{DynamicResource WarningBrush}" Margin="0,6,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>

      <StackPanel x:Name="ReadingPanel" Margin="0,20,0,0">
        <TextBlock x:Name="ReadingText" Text="{loc:T stream.reading}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap"/>
        <ProgressBar x:Name="ReadingBar" IsIndeterminate="True" Height="10" Margin="0,10,0,0" AutomationProperties.Name="{loc:T stream.reading}"/>
      </StackPanel>

      <StackPanel x:Name="FailedPanel" Margin="0,20,0,0" Visibility="Collapsed">
        <TextBox x:Name="FailureText" Style="{StaticResource SelectableText}" Foreground="{DynamicResource ErrorBrush}" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{loc:T stream.a11y.failure}"/>
        <Button x:Name="CopyFailureButton" Content="{loc:T stream.btn.copy}" Click="CopyFailure_Click" HorizontalAlignment="Left" MinWidth="84" Margin="0,10,0,0"/>
      </StackPanel>

      <StackPanel x:Name="ReadyPanel" Visibility="Collapsed">
        <StackPanel Margin="0,16,0,0"><Label Content="{loc:T capture.label.file_name}" Target="{Binding ElementName=NameInput}" Foreground="{DynamicResource InkBrush}" Padding="0,0,0,6"/>
          <TextBox x:Name="NameInput" AutomationProperties.Name="{loc:T capture.a11y.file_name}"/>
          <TextBlock Text="{loc:T stream.name_hint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
        <StackPanel Margin="0,16,0,0"><Label Content="{loc:T stream.label.quality}" Target="{Binding ElementName=QualityBox}" Foreground="{DynamicResource InkBrush}" Padding="0,0,0,6"/>
          <ComboBox x:Name="QualityBox" SelectionChanged="Quality_Changed" AutomationProperties.Name="{loc:T stream.a11y.quality}"/></StackPanel>
        <StackPanel x:Name="AudioPanel" Margin="0,16,0,0" Visibility="Collapsed"><Label Content="{loc:T stream.label.audio}" Target="{Binding ElementName=AudioBox}" Foreground="{DynamicResource InkBrush}" Padding="0,0,0,6"/>
          <ComboBox x:Name="AudioBox" SelectionChanged="Choice_Changed" AutomationProperties.Name="{loc:T stream.a11y.audio}"/></StackPanel>
        <StackPanel x:Name="FormatPanel" Margin="0,16,0,0" Visibility="Collapsed"><Label Content="{loc:T stream.label.format}" Target="{Binding ElementName=FormatBox}" Foreground="{DynamicResource InkBrush}" Padding="0,0,0,6"/>
          <ComboBox x:Name="FormatBox" SelectionChanged="Choice_Changed" AutomationProperties.Name="{loc:T stream.a11y.format}"/></StackPanel>
        <TextBox x:Name="EstimateInfo" Style="{StaticResource SelectableMuted}" Margin="0,10,0,0" AutomationProperties.Name="{loc:T stream.a11y.estimate}"/>

        <Border x:Name="ToolPanel" Visibility="Collapsed" Margin="0,16,0,0" Padding="12,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}" Background="{DynamicResource SurfaceBrush}">
          <StackPanel>
            <TextBox x:Name="ToolText" Style="{StaticResource SelectableText}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{loc:T stream.a11y.tool_notice}"/>
            <TextBlock x:Name="LicenceLine" Margin="0,6,0,0" TextWrapping="Wrap"><Hyperlink x:Name="LicenceLink" NavigateUri="https://ffmpeg.org/legal.html" Click="Licence_Click"><Run Text="{loc:T tool.licence}"/></Hyperlink></TextBlock>
            <ProgressBar x:Name="ToolBar" Height="10" Maximum="100" Margin="0,10,0,0" Visibility="Collapsed" AutomationProperties.Name="{loc:T tool.installing}"/>
            <WrapPanel x:Name="ToolButtons" Margin="0,10,0,0">
              <Button x:Name="InstallToolButton" Content="{loc:T tool.btn.install}" Click="InstallTool_Click" MinWidth="120" Margin="0,0,8,0"/>
              <Button x:Name="ContinueToolButton" Content="{loc:T tool.btn.continue}" Click="ContinueTool_Click" MinWidth="120" Margin="0,0,8,0"/>
              <Button x:Name="CancelToolButton" Content="{loc:T common.btn.cancel}" Click="CancelTool_Click" MinWidth="84" Margin="0,0,8,0" Visibility="Collapsed"/>
              <Button x:Name="CopyToolButton" Content="{loc:T stream.btn.copy}" Click="CopyTool_Click" MinWidth="84" Margin="0,0,8,0" Visibility="Collapsed"/>
            </WrapPanel>
          </StackPanel>
        </Border>

        <StackPanel Margin="0,16,0,0">
          <Label Content="{loc:T capture.label.save_to}" Target="{Binding ElementName=PathInput}" Foreground="{DynamicResource InkBrush}" Padding="0,0,0,6"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="PathInput" FlowDirection="LeftToRight" Grid.Column="0" AutomationProperties.Name="{loc:T capture.a11y.save_to_path}"/>
            <Button x:Name="BrowseButton" Grid.Column="1" Content="{loc:T capture.btn.browse}" Click="Browse_Click" MinWidth="84" Margin="8,0,0,0"/>
          </Grid>
        </StackPanel>
        <StackPanel Margin="0,16,0,0">
          <Label Content="{loc:T capture.label.category}" Target="{Binding ElementName=CategoryDropdown}" Foreground="{DynamicResource InkBrush}" Padding="0,0,0,6"/>
          <ComboBox x:Name="CategoryDropdown" AutomationProperties.Name="{loc:T capture.a11y.download_category}">
            <ComboBoxItem Content="{loc:T capture.item.general}" Tag="General"/>
            <ComboBoxItem Content="{loc:T capture.item.programs}" Tag="Programs"/>
            <ComboBoxItem Content="{loc:T capture.item.compressed}" Tag="Compressed"/>
            <ComboBoxItem Content="{loc:T capture.item.documents}" Tag="Documents"/>
            <ComboBoxItem Content="{loc:T capture.item.music}" Tag="Music"/>
            <ComboBoxItem Content="{loc:T capture.item.video}" Tag="Video"/>
          </ComboBox>
        </StackPanel>
        <StackPanel Margin="0,16,0,0" x:Name="SchedulePanel" Visibility="Collapsed">
          <Label Content="{loc:T common.label.local_date_and_time_yyyy_mm}" Target="{Binding ElementName=ScheduleInput}" Foreground="{DynamicResource InkBrush}"/><TextBox x:Name="ScheduleInput" FlowDirection="LeftToRight" AutomationProperties.Name="{loc:T common.a11y.scheduled_local_date_and_time}"/>
          <TextBlock Text="{loc:T common.text.uses_this_computers_time_zone_neodm}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
      </StackPanel>
      <TextBox x:Name="ValidationError" Style="{StaticResource SelectableText}" Foreground="{DynamicResource ErrorBrush}" Margin="0,12,0,8" AutomationProperties.LiveSetting="Assertive"/>
    </StackPanel></ScrollViewer>
    <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="CancelButton" Content="{loc:T common.btn.cancel}" Click="Cancel_Click" IsCancel="True" MinWidth="84" Margin="0,0,8,0"/>
      <Button x:Name="QueueButton" Content="{loc:T capture.btn.add_to_queue}" Click="Queue_Click" MinWidth="100" Margin="0,0,8,0" Visibility="Collapsed"/>
      <Button x:Name="ScheduleButton" Content="{loc:T capture.btn.schedule}" Click="Schedule_Click" MinWidth="84" Margin="0,0,8,0" Visibility="Collapsed"/>
      <Button x:Name="StartButton" Content="{loc:T stream.btn.start}" Click="Start_Click" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="120" Visibility="Collapsed"/>
    </WrapPanel>
  </Grid>
</Window>
