<Window x:Class="NDM.App.BridgeStatusWindow" Style="{StaticResource {x:Type Window}}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browser connection" Icon="Assets/NDM.ico" Width="640" Height="560" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" FontSize="13">
  <Grid Margin="22,18,22,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="100"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="OverallBadge" Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top" Background="{DynamicResource BorderBrush}">
        <TextBlock x:Name="OverallGlyph" Text="?" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource OnAccentBrush}"/>
      </Border>
      <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="OverallText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock x:Name="WhenText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
      </StackPanel>
    </Grid>
    <ScrollViewer x:Name="ItemsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" AutomationProperties.Name="Checks">
      <StackPanel x:Name="ItemsPanel" Margin="0,0,16,0"/>
    </ScrollViewer>
    <TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap" Margin="0,10,0,0" MinHeight="18" AutomationProperties.LiveSetting="Polite"/>
    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <WrapPanel>
        <Button x:Name="CheckButton" Content="Check _now" Click="Check_Click" MinWidth="96" MinHeight="32" Margin="0,0,8,6" Style="{StaticResource PrimaryButton}"/>
        <Button x:Name="RepairButton" Content="_Repair" Click="Repair_Click" MinWidth="80" MinHeight="32" Margin="0,0,8,6"/>
        <Button x:Name="CopyButton" Content="Copy _report" Click="Copy_Click" MinWidth="96" MinHeight="32" Margin="0,0,8,6"/>
        <Button x:Name="GuideButton" Content="_Install guide" Click="Guide_Click" MinWidth="96" MinHeight="32" Margin="0,0,8,6"/>
      </WrapPanel>
      <Button x:Name="CloseButton" Grid.Column="1" Content="_Close" IsCancel="True" Click="Close_Click" MinWidth="88" MinHeight="32" VerticalAlignment="Top" Margin="8,0,0,6"/>
    </Grid>
  </Grid>
</Window>
