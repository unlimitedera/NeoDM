<UserControl x:Class="NDM.App.StreamJoinPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:NDM.App.Localization" xmlns:app="clr-namespace:NDM.App" Visibility="Collapsed">
  <StackPanel>
    <TextBox x:Name="NoteText" Style="{StaticResource SelectableText}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{loc:T stream.a11y.note}"/>
    <TextBox x:Name="FilesText" Style="{StaticResource SelectableMuted}" Margin="0,6,0,0" Visibility="Collapsed" AutomationProperties.Name="{loc:T stream.saved_files}"/>
    <ProgressBar x:Name="JoinBar" Height="10" Maximum="100" Margin="0,10,0,0" Visibility="Collapsed" AutomationProperties.Name="{loc:T stream.join.running}"/>
    <TextBox x:Name="ResultText" Style="{StaticResource SelectableText}" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{loc:T stream.a11y.join_result}"/>
    <WrapPanel Margin="0,10,0,0">
      <Button x:Name="JoinButton" Content="{loc:T stream.btn.install_and_join}" Click="Join_Click" Margin="0,0,8,0" Padding="14,6"/>
      <Button x:Name="CancelJoinButton" Content="{loc:T common.btn.cancel}" Click="CancelJoin_Click" Margin="0,0,8,0" MinWidth="84" Visibility="Collapsed"/>
      <Button x:Name="CopyResultButton" Content="{loc:T stream.btn.copy}" Click="CopyResult_Click" Margin="0,0,8,0" MinWidth="84" Visibility="Collapsed"/>
    </WrapPanel>
    <TextBlock x:Name="LicenceLine" Margin="0,4,0,0" TextWrapping="Wrap"><Hyperlink NavigateUri="https://ffmpeg.org/legal.html" Click="Licence_Click"><Run Text="{loc:T tool.licence}"/></Hyperlink></TextBlock>
  </StackPanel>
</UserControl>
