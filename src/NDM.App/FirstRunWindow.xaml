<Window x:Class="NDM.App.FirstRunWindow" Style="{StaticResource {x:Type Window}}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:NDM.App.Localization"
        Title="{loc:T firstrun.title}" Width="560" SizeToContent="Height" MinWidth="340" MinHeight="300" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22">
      <TextBlock Text="{loc:T firstrun.title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <TextBlock Text="{loc:T firstrun.intro}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,16"/>
      <TextBlock Text="{loc:T firstrun.folder}" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="FolderBox" FlowDirection="LeftToRight" MinHeight="32" Padding="8,5" VerticalContentAlignment="Center" AutomationProperties.Name="{loc:T firstrun.folder.a11y}"/>
        <Button x:Name="BrowseButton" Grid.Column="1" Content="{loc:T common.btn.browse}" Click="Browse_Click" MinHeight="32" Margin="8,0,0,0" Padding="12,4"/>
      </Grid>
      <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Assertive"/>
      <TextBlock Text="{loc:T firstrun.ext.title}" FontWeight="SemiBold" Margin="0,18,0,6"/>
      <TextBlock x:Name="ExtensionState" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      <Button x:Name="GuideButton" Content="{loc:T firstrun.ext.guide}" Click="Guide_Click" HorizontalAlignment="Left" MinHeight="32" Padding="12,4" Margin="0,8,0,0"/>
      <TextBlock Text="{loc:T firstrun.theme}" FontWeight="SemiBold" Margin="0,18,0,6"/>
      <ComboBox x:Name="ThemeBox" HorizontalAlignment="Left" MinWidth="260" SelectionChanged="Theme_Changed" AutomationProperties.Name="{loc:T firstrun.theme}"/>
      <WrapPanel HorizontalAlignment="Right" Margin="0,22,0,0">
        <Button x:Name="SkipButton" Content="{loc:T firstrun.btn.skip}" IsCancel="True" Click="Skip_Click" MinWidth="90" MinHeight="32" Margin="0,0,8,0"/>
        <Button x:Name="FinishButton" Content="{loc:T firstrun.btn.finish}" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Finish_Click" MinWidth="90" MinHeight="32"/>
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
