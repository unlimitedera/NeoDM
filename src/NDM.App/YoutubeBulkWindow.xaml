<Window Style="{StaticResource {x:Type Window}}" x:Class="NDM.App.YoutubeBulkWindow" Icon="Assets/NDM.ico" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:NDM.App.Localization" Title="{loc:T youtube.bulk_title}" Width="520" MinWidth="380" SizeToContent="Height" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBox x:Name="Intro" Style="{StaticResource SelectableText}" TextWrapping="Wrap"/>
      <RadioButton x:Name="OneByOne" Content="{loc:T youtube.bulk_sequential}" IsChecked="True" GroupName="mode" Foreground="{DynamicResource InkBrush}" Margin="0,14,0,6" Checked="Mode_Changed"/>
      <RadioButton x:Name="QueueAll" Content="{loc:T youtube.bulk_queue_all}" GroupName="mode" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6" Checked="Mode_Changed"/>
      <StackPanel x:Name="PresetPanel" Margin="24,4,0,0" IsEnabled="False">
        <Label Content="{loc:T youtube.quality}" Target="{Binding ElementName=QualityBox}" Padding="0,0,0,2"/>
        <ComboBox x:Name="QualityBox" FlowDirection="LeftToRight" HorizontalAlignment="Left" MinWidth="140"/>
        <CheckBox x:Name="AudioOnlyBox" Content="{loc:T youtube.audio_only}" Foreground="{DynamicResource InkBrush}" Margin="0,8,0,0"/>
        <CheckBox x:Name="Mp3Box" Content="{loc:T youtube.mp3}" Foreground="{DynamicResource InkBrush}" Margin="18,6,0,0"/>
      </StackPanel>
    </StackPanel>
    <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="{loc:T common.btn.cancel}" IsCancel="True" MinWidth="84" Margin="0,0,8,0"/>
      <Button Content="{loc:T prompt.btn.ok}" IsDefault="True" Click="Ok_Click" MinWidth="84" Style="{StaticResource PrimaryButton}"/>
    </WrapPanel>
  </Grid>
</Window>
