<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NDM.App" Style="{StaticResource {x:Type Window}}" x:Class="NDM.App.MainWindow" Icon="Assets/NDM.ico" Title="NeoDM" Width="1180" Height="720" MinWidth="900" MinHeight="480" FontSize="13" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Window.Resources>
    <Style x:Key="Command" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="{DynamicResource CommandPadding}"/>
      <Setter Property="MinHeight" Value="{DynamicResource CommandMinHeight}"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>
    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
      <Setter Property="MinHeight" Value="30"/>
    </Style>
  </Window.Resources>
  <DockPanel>
    <Menu x:Name="MainMenu" DockPanel.Dock="Top" Padding="4,2" AutomationProperties.Name="Main menu">
      <MenuItem Header="_Tasks">
        <MenuItem Header="_Add URL…" Click="Add_Click" InputGestureText="Ctrl+N"/>
        <MenuItem Header="_Import URLs…" Click="Bulk_Click"/>
        <MenuItem Header="Add _torrent file…" Click="AddTorrentFile_Click" Tag="torrent"/>
        <MenuItem Header="Remove _completed" Click="RemoveCompleted_Click"/>
        <MenuItem Header="_Scheduler…" Click="Schedule_Click" IsEnabled="{Binding IsEnabled, ElementName=ScheduleButton}"/>
      </MenuItem>
      <MenuItem Header="_File">
        <MenuItem Header="Add _torrent file…" Click="AddTorrentFile_Click" Tag="torrent"/>
        <MenuItem Header="_Open file…" Click="Open_Click" IsEnabled="{Binding IsEnabled, ElementName=OpenButton}"/>
        <MenuItem Header="Open _folder" Click="Folder_Click" IsEnabled="{Binding IsEnabled, ElementName=FolderButton}"/>
        <MenuItem Header="E_xit" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="_Downloads">
        <MenuItem Header="_Resume" Click="Resume_Click" IsEnabled="{Binding IsEnabled, ElementName=ResumeButton}"/>
        <MenuItem Header="_Stop" Click="Stop_Click" IsEnabled="{Binding IsEnabled, ElementName=StopButton}"/>
        <MenuItem Header="Stop _all" Click="PauseAll_Click" IsEnabled="{Binding IsEnabled, ElementName=PauseAllButton}"/>
        <MenuItem Header="Resume all paused" Click="ResumeAll_Click" IsEnabled="{Binding IsEnabled, ElementName=ResumeAllButton}"/>
        <MenuItem x:Name="ProgressMenu" Header="_Progress…" Click="Progress_Click"/>
        <MenuItem Header="Speed _limit…" Click="Speed_Click" IsEnabled="{Binding IsEnabled, ElementName=SpeedButton}"/>
        <MenuItem Header="_Remove…" Click="Remove_Click" IsEnabled="{Binding IsEnabled, ElementName=RemoveButton}"/>
        <Separator/>
        <MenuItem x:Name="FinishMenu" Header="When downloads _finish"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_All downloads" Click="ViewFilter_Click" Tag="All"/>
        <MenuItem Header="_Downloading" Click="ViewFilter_Click" Tag="Downloading"/>
        <MenuItem Header="_Paused" Click="ViewFilter_Click" Tag="Paused"/>
        <MenuItem Header="_Completed" Click="ViewFilter_Click" Tag="Completed"/>
        <MenuItem Header="_Failed" Click="ViewFilter_Click" Tag="Failed"/>
        <Separator Tag="torrent"/>
        <MenuItem Header="All _torrents" Click="ViewFilter_Click" Tag="T:All"/>
        <MenuItem Header="Torrents downloading" Click="ViewFilter_Click" Tag="T:Downloading"/>
        <MenuItem Header="Torrents _seeding" Click="ViewFilter_Click" Tag="T:Seeding"/>
        <MenuItem Header="Torrents completed" Click="ViewFilter_Click" Tag="T:Completed"/>
        <Separator Tag="torrent"/>
        <MenuItem Header="_Find" Click="Find_Click" InputGestureText="Ctrl+F"/>
        <MenuItem Header="_Refresh" Click="Refresh_Click" InputGestureText="F5"/>
      </MenuItem>
      <MenuItem x:Name="OptionsMenuItem" Header="_Options" Click="Settings_Click" AutomationProperties.Name="Options"/>
      <MenuItem Header="_Help">
        <MenuItem Header="Keyboard _shortcuts" Click="Help_Click"/>
        <MenuItem x:Name="ExtensionGuideMenuItem" Header="Browser e_xtension install guide…" Click="ExtensionGuide_Click"/>
        <MenuItem x:Name="BridgeStatusMenuItem" Header="_Browser connection…" Click="BridgeStatus_Click"/>
        <MenuItem Header="_Check for updates…" Click="CheckUpdates_Click"/>
        <MenuItem Header="_About NeoDM" Click="About_Click"/>
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="8,7" Background="{DynamicResource SidebarBrush}">
      <WrapPanel>
        <Button Content="Add _URL…" Click="Add_Click" Style="{StaticResource Command}"/>
        <Button x:Name="AddTorrentButton" Content="Add _torrent…" Click="AddTorrentFile_Click" Style="{StaticResource Command}"/>
        <Button x:Name="ResumeButton" Content="Resume" Click="Resume_Click" Style="{StaticResource Command}"/>
        <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" Style="{StaticResource Command}"/>
        <Button x:Name="PauseAllButton" Content="Stop all" Click="PauseAll_Click" Style="{StaticResource Command}"/>
        <Button x:Name="RemoveButton" Content="Remove" Click="Remove_Click" Style="{StaticResource Command}"/>
        <Button Content="Remove completed" Click="RemoveCompleted_Click" Style="{StaticResource Command}"/>
        <Button Content="Options…" Click="Settings_Click" Style="{StaticResource Command}"/>
        <Button x:Name="ScheduleButton" Content="Scheduler…" Click="Schedule_Click" Style="{StaticResource Command}"/>
      </WrapPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Notice" Text="Ready" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <TextBlock x:Name="Summary" Style="{StaticResource Muted}" Margin="12,0"/>
          <TextBlock x:Name="RateLabel" Style="{StaticResource Muted}"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="166"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="8,12">
          <TextBlock DockPanel.Dock="Top" Text="DOWNLOADS" FontSize="11" FontWeight="SemiBold" Style="{StaticResource Muted}" Margin="8,0,0,10"/>
          <StackPanel DockPanel.Dock="Bottom">
            <Button x:Name="BulkButton" Content="Import URLs…" Click="Bulk_Click" Style="{StaticResource Command}"/>
            <Button x:Name="ResumeAllButton" MinHeight="36" Content="Resume all paused" Click="ResumeAll_Click" Style="{StaticResource Command}"/>
          </StackPanel>
          <ListBox x:Name="Navigation" SelectionChanged="FilterChanged" ItemContainerStyle="{StaticResource NavItem}" AutomationProperties.Name="Download status filters">
            <ListBoxItem Tag="All" IsSelected="True">
              <TextBlock Text="All downloads"/>
            </ListBoxItem>
            <ListBoxItem Tag="Downloading">
              <TextBlock Text="Downloading"/>
            </ListBoxItem>
            <ListBoxItem Tag="Paused">
              <TextBlock Text="Paused"/>
            </ListBoxItem>
            <ListBoxItem Tag="Completed">
              <TextBlock Text="Completed"/>
            </ListBoxItem>
            <ListBoxItem Tag="Failed">
              <TextBlock Text="Failed"/>
            </ListBoxItem>
            <ListBoxItem Tag="Queued">
              <TextBlock Text="Queued"/>
            </ListBoxItem>
            <ListBoxItem Tag="Scheduled">
              <TextBlock Text="Scheduled"/>
            </ListBoxItem>
            <ListBoxItem Tag="header" x:Name="TorrentsHeader" Focusable="False" IsHitTestVisible="False" AutomationProperties.Name="Torrents section">
              <TextBlock Text="TORRENTS" FontSize="11" FontWeight="SemiBold" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
            </ListBoxItem>
            <ListBoxItem Tag="T:All">
              <TextBlock Text="All torrents"/>
            </ListBoxItem>
            <ListBoxItem Tag="T:Downloading">
              <TextBlock Text="Downloading"/>
            </ListBoxItem>
            <ListBoxItem Tag="T:Seeding">
              <TextBlock Text="Seeding"/>
            </ListBoxItem>
            <ListBoxItem Tag="T:Completed">
              <TextBlock Text="Completed"/>
            </ListBoxItem>
          </ListBox>
        </DockPanel>
      </Border>
      <DockPanel Grid.Column="1" Margin="10,0,10,8">
        <Grid DockPanel.Dock="Top" Margin="0,9">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="230"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="Heading" Text="All downloads" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock x:Name="CountLabel" Grid.Column="1" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0"/>
          <TextBox x:Name="Search" Grid.Column="2" TextChanged="SearchChanged" MinHeight="30" Padding="8,4" ToolTip="Search file names or URLs (Ctrl+F)" AutomationProperties.Name="Search downloads"/>
        </Grid>
        <Border DockPanel.Dock="Bottom" x:Name="DetailsPanel" Visibility="Collapsed" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="DetailName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <TextBlock x:Name="DetailPath" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              </StackPanel>
              <WrapPanel Grid.Column="1" Margin="10,0,0,0">
                <Button x:Name="PauseButton" Content="Pause" Click="Pause_Click" Style="{StaticResource Command}"/>
                <Button x:Name="SpeedButton" Content="Speed limit…" Click="Speed_Click" Style="{StaticResource Command}"/>
                <Button x:Name="OpenButton" Content="Open file" Click="Open_Click" Style="{StaticResource Command}"/>
                <Button x:Name="FolderButton" Content="Open folder" Click="Folder_Click" Style="{StaticResource Command}"/>
              </WrapPanel>
            </Grid>
            <TextBlock x:Name="DetailTorrent" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" Visibility="Collapsed"/>
            <TextBlock x:Name="DetailError" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" MaxHeight="60" Margin="0,5,0,0"/>
          </StackPanel>
        </Border>
        <Grid>
          <ListView x:Name="DownloadList" local:ListViewFill.FillColumn="0" local:ListViewFill.MinFillWidth="205" ItemsSource="{Binding Rows}" SelectionChanged="SelectionChanged" MouseDoubleClick="List_DoubleClick" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource InkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Download queue">
            <ListView.ContextMenu>
              <ContextMenu>
                <MenuItem x:Name="CtxOpen" Header="_Open" Click="ContextOpen_Click"/>
                <MenuItem x:Name="CtxOpenWith" Header="Open _with…" Click="ContextOpenWith_Click"/>
                <MenuItem x:Name="CtxFolder" Header="Open _folder" Click="ContextFolder_Click"/>
                <Separator/>
                <MenuItem x:Name="CtxCopyUrl" Header="Copy _URL (address)" Click="ContextCopyUrl_Click"/>
                <MenuItem x:Name="CtxCopyPath" Header="Copy file _path" Click="ContextCopyPath_Click"/>
                <MenuItem x:Name="CtxMagnet" Header="Copy _magnet link" Click="ContextCopyMagnet_Click"/>
                <MenuItem x:Name="CtxMove" Header="Move / _Rename…" Click="ContextMove_Click"/>
                <MenuItem x:Name="CtxProperties" Header="Propert_ies…" Click="ContextProperties_Click"/>
                <MenuItem x:Name="CtxDetails" Header="Torrent _details…" Click="ContextDetails_Click"/>
                <Separator/>
                <MenuItem x:Name="CtxResume" Header="Resu_me" Click="ContextResume_Click"/>
                <MenuItem x:Name="CtxStop" Header="S_top (pause)" Click="ContextStop_Click"/>
                <MenuItem x:Name="CtxRefreshUrl" Header="Re_fresh address…" Click="ContextRefreshUrl_Click"/>
                <MenuItem x:Name="CtxRedownload" Header="Redo_wnload" Click="ContextRedownload_Click"/>
                <Separator/>
                <MenuItem x:Name="CtxSpeed" Header="Set speed _limit…" Click="Speed_Click"/>
                <MenuItem x:Name="CtxSchedule" Header="Sc_hedule…" Click="Schedule_Click"/>
                <Separator/>
                <MenuItem x:Name="CtxRemove" Header="_Remove…" Click="ContextRemove_Click" InputGestureText="Del"/>
                <MenuItem x:Name="CtxDelete" Header="_Delete from disk…" Click="ContextDelete_Click"/>
              </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
              <GridView AllowsColumnReorder="True">
                <GridViewColumn Width="205">
                  <GridViewColumn.Header>
                    <GridViewColumnHeader Content="Filename" Tag="FileName" Click="Sort_Click"/>
                  </GridViewColumn.Header>
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayUrl}"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="85" DisplayMemberBinding="{Binding Size}">
                  <GridViewColumn.Header>
                    <GridViewColumnHeader Content="Size" Tag="TotalBytes" Click="Sort_Click"/>
                  </GridViewColumn.Header>
                </GridViewColumn>
                <GridViewColumn Width="95" DisplayMemberBinding="{Binding Status}">
                  <GridViewColumn.Header>
                    <GridViewColumnHeader Content="Status" Tag="Status" Click="Sort_Click"/>
                  </GridViewColumn.Header>
                </GridViewColumn>
                <GridViewColumn Width="112">
                  <GridViewColumn.Header>
                    <GridViewColumnHeader Content="Progress" Tag="Progress" Click="Sort_Click"/>
                  </GridViewColumn.Header>
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <Grid Width="92">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="55"/>
                          <ColumnDefinition Width="37"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="5" VerticalAlignment="Center" ToolTip="{Binding Detail}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Percent}" HorizontalAlignment="Right"/>
                      </Grid>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="90" DisplayMemberBinding="{Binding Remaining}">
                  <GridViewColumn.Header>
                    <GridViewColumnHeader Content="Remaining" Tag="RemainingTime" Click="Sort_Click"/>
                  </GridViewColumn.Header>
                </GridViewColumn>
                <GridViewColumn Width="90" DisplayMemberBinding="{Binding SpeedText}">
                  <GridViewColumn.Header>
                    <GridViewColumnHeader Content="Speed" Tag="Speed" Click="Sort_Click"/>
                  </GridViewColumn.Header>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30" IsHitTestVisible="False">
            <TextBlock x:Name="EmptyHeading" Text="No downloads" FontSize="16" FontWeight="SemiBold" TextAlignment="Center"/>
            <TextBlock x:Name="EmptyBody" Text="Add a URL or import a list to begin." Style="{StaticResource Muted}" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
