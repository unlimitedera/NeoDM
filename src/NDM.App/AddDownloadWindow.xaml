<Window Style="{StaticResource {x:Type Window}}" x:Class="NDM.App.AddDownloadWindow" Icon="Assets/NDM.ico" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:NDM.App.Localization" Title="{loc:T add.title.add_download}" Width="580" Height="660" MinHeight="480" MinWidth="520" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,16,0">
    <StackPanel><TextBlock Text="{loc:T add.text.add_a_download}" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="Intro" Text="{loc:T add.text.enter_a_direct_http_or_https}" Style="{StaticResource Muted}" Margin="0,7,0,20"/></StackPanel>
    <StackPanel Grid.Row="1"><Label Content="{loc:T common.label.download_url}" Target="{Binding ElementName=UrlInput}" Foreground="{DynamicResource InkBrush}" Padding="0,0,0,6"/><TextBox x:Name="UrlInput" FlowDirection="LeftToRight" AutomationProperties.Name="{loc:T common.a11y.download_url}"/></StackPanel>
    <StackPanel Grid.Row="2" Margin="0,16,0,0"><Label Content="{loc:T add.label.file_name_optional}" Target="{Binding ElementName=NameInput}" Foreground="{DynamicResource InkBrush}" Padding="0,0,0,6"/><TextBox x:Name="NameInput" AutomationProperties.Name="{loc:T add.a11y.optional_file_name}"/></StackPanel>
    <StackPanel Grid.Row="3" Margin="0,16,0,0">
      <CheckBox x:Name="ScheduleEnabled" Content="{loc:T add.chk.schedule_for_later}" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6"/>
      <Label Content="{loc:T common.label.local_date_and_time_yyyy_mm}" Target="{Binding ElementName=ScheduleInput}" Foreground="{DynamicResource InkBrush}"/><TextBox x:Name="ScheduleInput" FlowDirection="LeftToRight" IsEnabled="{Binding IsChecked, ElementName=ScheduleEnabled}" AutomationProperties.Name="{loc:T common.a11y.scheduled_local_date_and_time}"/>
      <TextBlock Text="{loc:T common.text.uses_this_computers_time_zone_neodm}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      <Label Content="{loc:T common.label.speed_limit_kib_s_blank_unlimited}" Target="{Binding ElementName=SpeedInput}" Foreground="{DynamicResource InkBrush}" Margin="0,12,0,0"/><TextBox x:Name="SpeedInput" FlowDirection="LeftToRight" AutomationProperties.Name="{loc:T common.a11y.speed_limit_in_kib_per_second}"/>
      <TextBlock Text="{loc:T common.text.positive_whole_numbers_shared_across_thi}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      <TextBlock x:Name="ValidationError" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,12,0,8" AutomationProperties.LiveSetting="Assertive"/>
    </StackPanel>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="{loc:T common.btn.cancel}" IsCancel="True" MinWidth="84" Margin="0,0,8,0"/><Button Content="{loc:T add.title.add_download}" IsDefault="True" Click="Accept_Click" Style="{StaticResource PrimaryButton}"/></StackPanel>
  </Grid>
</Window>