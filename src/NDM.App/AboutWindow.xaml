<Window x:Class="NDM.App.AboutWindow" Style="{StaticResource {x:Type Window}}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:NDM.App.Localization"
        Title="{loc:T about.title.about_neodm}" Icon="Assets/NDM.ico" Width="540" Height="600" MinWidth="460" MinHeight="460" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13">
  <Grid Margin="24,22,24,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <Image Source="Assets/NDM.ico" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="{loc:T about.a11y.neodm_icon}"/>
      <StackPanel Margin="16,4,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="AppName" Text="NeoDM" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" FontSize="14" Margin="0,2,0,0"/>
      </StackPanel>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,18,0,14">
      <TextBlock x:Name="CreatorText" Text="{loc:T about.text.neodm_is_an_open_source_project}" TextWrapping="Wrap"/>
      <TextBlock x:Name="LicenseText" Text="{loc:T about.text.released_under_the_mit_license}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
      <TextBlock Margin="0,6,0,0"><Run Text="{loc:T about.text.source_code}"/><Hyperlink x:Name="RepoLink" NavigateUri="https://github.com/unlimitedera/NeoDM" Click="Repo_Click">github.com/unlimitedera/NeoDM</Hyperlink></TextBlock>
      <Button x:Name="InstallGuideButton" Content="{loc:T about.btn.browser_extension_install_guide}" Click="InstallGuide_Click" HorizontalAlignment="Left" MinHeight="30" Margin="0,10,0,0"/>
    </StackPanel>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{loc:T about.text.whats_new}" FontSize="16" FontWeight="SemiBold" Margin="14,12,14,6"/>
        <ScrollViewer x:Name="ChangelogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" AutomationProperties.Name="{loc:T about.text.whats_new}">
          <StackPanel x:Name="ChangelogPanel" FlowDirection="LeftToRight" Margin="14,0,14,12"/>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <Grid Grid.Row="3" Margin="0,16,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"><Button x:Name="CheckUpdatesButton" Content="{loc:T about.btn.check_for_updates}" Click="CheckUpdates_Click" MinWidth="140" MinHeight="32"/><TextBlock x:Name="UpdateStatus" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="170" AutomationProperties.LiveSetting="Polite"/></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CloseButton" Content="{loc:T common.btn.close}" IsDefault="True" IsCancel="True" MinWidth="96" MinHeight="32" Style="{StaticResource PrimaryButton}" Click="Close_Click"/>
    </StackPanel></Grid>
  </Grid>
</Window>
