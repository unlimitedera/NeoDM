<Window x:Class="NDM.App.PropertiesWindow" Style="{StaticResource {x:Type Window}}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Properties" Width="600" SizeToContent="Height" MinWidth="480" MinHeight="300" MaxHeight="900" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13">
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,16,0">
    <TextBlock x:Name="Title2" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <ItemsControl x:Name="Fields" Margin="0,14,0,0" AutomationProperties.Name="Download properties">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" VerticalAlignment="Top" Padding="0,6,0,0"/>
            <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource InkBrush}" AutomationProperties.Name="{Binding Label}"/>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="Copy _address" Click="CopyAddress_Click" Margin="0,0,8,0" MinWidth="110" MinHeight="32"/>
      <Button Content="_Close" IsDefault="True" IsCancel="True" Click="Close_Click" MinWidth="90" MinHeight="32" Style="{StaticResource PrimaryButton}"/>
    </StackPanel>
  </Grid>
</Window>
