<Window Style="{StaticResource {x:Type Window}}" x:Class="NDM.App.PlaylistOptionsDialog" Icon="Assets/NDM.ico" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:pstat="clr-namespace:NDM.App" xmlns:loc="clr-namespace:NDM.App.Localization" Title="{loc:T playlist.title}" Width="860" Height="820" MinWidth="560" MinHeight="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="BodyScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
    <Grid x:Name="Body" Margin="0,0,4,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock Text="{loc:T playlist.title}" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="{loc:T youtube.notice}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,10"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="UrlDisplay" IsReadOnly="True" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
        <Button x:Name="ReadButton" Grid.Column="1" Content="{loc:T playlist.read}" Click="Read_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" AutomationProperties.HelpText="{loc:T playlist.read_hint}"/>
      </Grid>
      <TextBlock x:Name="ReadHint" Text="{loc:T playlist.read_hint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,8"/>
      <Border x:Name="LoadPanel" Visibility="Collapsed" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
        <StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="LoadingStatus" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock x:Name="LoadingPercent" Grid.Column="1" Text="0%" FontWeight="SemiBold" Margin="12,0,0,0" FlowDirection="LeftToRight"/>
          </Grid>
          <ProgressBar x:Name="LoadingProgress" Minimum="0" Maximum="100" pstat:ProgressStatus.Kind="Downloading" pstat:ProgressStatus.Active="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Height="8" Margin="0,8,0,8" AutomationProperties.Name="{loc:T youtube.progress_name}"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="LoadingElapsed" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Button x:Name="CancelLoadButton" Grid.Column="1" Content="{loc:T youtube.load_cancel}" Click="CancelLoad_Click" MinWidth="84"/>
          </Grid>
          <TextBlock Text="{loc:T youtube.progress_estimate}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
      <Grid x:Name="ErrorRow" Visibility="Collapsed" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="Error" Style="{StaticResource SelectableText}" Foreground="{DynamicResource ErrorBrush}" AutomationProperties.LiveSetting="Assertive" TextChanged="Error_TextChanged"/>
        <Button x:Name="CopyErrorButton" Grid.Column="1" Content="{loc:T youtube.copy_error}" Click="CopyError_Click" VerticalAlignment="Top" Margin="8,0,0,0"/>
      </Grid>
    </StackPanel>
    <StackPanel Grid.Row="1" x:Name="OptionsPanel" IsEnabled="False">
      <TextBlock x:Name="Step2Label" Text="{loc:T playlist.step2}" FontWeight="SemiBold" Margin="0,2,0,6"/>
      <TextBox x:Name="Summary" Style="{StaticResource SelectableText}" Margin="0,0,0,2" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock x:Name="TruncatedNote" Style="{StaticResource Muted}" TextWrapping="Wrap" Visibility="Collapsed"/>
      <WrapPanel Margin="0,6,0,0">
        <StackPanel Margin="0,0,16,6"><Label Content="{loc:T youtube.pick.resolution}" Target="{Binding ElementName=QualityBox}" Padding="0,0,0,2"/><ComboBox x:Name="QualityBox" MinWidth="130" FlowDirection="LeftToRight" SelectionChanged="Global_Changed"/></StackPanel>
        <StackPanel Margin="0,0,16,6"><Label Content="{loc:T playlist.audio_quality}" Target="{Binding ElementName=AudioBox}" Padding="0,0,0,2"/><ComboBox x:Name="AudioBox" MinWidth="130" FlowDirection="LeftToRight" SelectionChanged="Global_Changed"/></StackPanel>
        <StackPanel Margin="0,0,0,6" VerticalAlignment="Bottom">
          <CheckBox x:Name="AudioOnlyBox" Content="{loc:T youtube.audio_only}" Checked="Global_Toggled" Unchecked="Global_Toggled" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,4"/>
          <CheckBox x:Name="Mp3Box" Content="{loc:T youtube.mp3}" Checked="Global_Toggled" Unchecked="Global_Toggled" Foreground="{DynamicResource InkBrush}" Margin="18,0,0,0"/>
        </StackPanel>
      </WrapPanel>
      <WrapPanel Margin="0,2,0,0">
        <StackPanel Margin="0,0,16,6"><Label Content="{loc:T youtube.pick.container}" Target="{Binding ElementName=ContainerBox}" Padding="0,0,0,2"/><ComboBox x:Name="ContainerBox" MinWidth="130" FlowDirection="LeftToRight" SelectionChanged="Global_Changed"/></StackPanel>
        <StackPanel Margin="0,0,16,6"><Label Content="{loc:T youtube.subs.title}" Target="{Binding ElementName=SubtitleKindBox}" Padding="0,0,0,2"/><ComboBox x:Name="SubtitleKindBox" MinWidth="200" SelectionChanged="Global_Changed"/></StackPanel>
        <StackPanel x:Name="SubtitleCodesPanel" Margin="0,0,16,6" Visibility="Collapsed"><Label Content="{loc:T playlist.subs.codes}" Target="{Binding ElementName=SubtitleCodes}" Padding="0,0,0,2"/><TextBox x:Name="SubtitleCodes" MinWidth="130" FlowDirection="LeftToRight" TextChanged="Global_Text" ToolTip="{loc:T playlist.subs.codes_hint}"/></StackPanel>
        <StackPanel x:Name="SubtitleModePanel" Margin="0,0,0,6" VerticalAlignment="Bottom" Visibility="Collapsed">
          <RadioButton x:Name="SubEmbed" GroupName="PlSubMode" Content="{loc:T youtube.subs.embed}" IsChecked="True" Checked="Global_Toggled" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,2"/>
          <RadioButton x:Name="SubSeparate" GroupName="PlSubMode" Content="{loc:T youtube.subs.separate}" Checked="Global_Toggled" Foreground="{DynamicResource InkBrush}"/>
        </StackPanel>
      </WrapPanel>
    </StackPanel>
    <Grid Grid.Row="2" x:Name="ToolsRow" IsEnabled="False" Margin="0,4,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="SelectAllButton" Content="{loc:T playlist.select_all}" Click="SelectAll_Click" Margin="0,0,6,0"/>
        <Button x:Name="SelectNoneButton" Content="{loc:T playlist.select_none}" Click="SelectNone_Click" Margin="0,0,6,0"/>
        <Button x:Name="InvertButton" Content="{loc:T playlist.invert}" Click="Invert_Click" Margin="0,0,12,0"/>
      </StackPanel>
      <TextBox x:Name="FilterBox" Grid.Column="1" TextChanged="Filter_Changed" AutomationProperties.Name="{loc:T playlist.filter}" ToolTip="{loc:T playlist.filter}"/>
    </Grid>
    <ListBox x:Name="VideoList" Grid.Row="3" MinHeight="140" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" PreviewKeyDown="List_KeyDown" AutomationProperties.Name="{loc:T playlist.list_name}" ToolTip="{loc:T playlist.duration_tip}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="2,4" Loaded="Row_Loaded" Unloaded="Row_Unloaded" Opacity="{Binding RowOpacity}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding Available}" VerticalAlignment="Center" Margin="4,0,8,0" AutomationProperties.Name="{Binding Title}"/>
            <Border Grid.Column="1" Width="120" Height="68" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0" FlowDirection="LeftToRight">
              <Grid>
                <Path x:Name="NoPicture" Data="M0,0 L16,9 L0,18 Z" Fill="{DynamicResource MutedBrush}" Opacity="0.6" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{loc:T playlist.thumb.none}"/>
                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Grid>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" ToolTip="{Binding Title}"/>
              <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding StateText}" Foreground="{DynamicResource ErrorBrush}" FontWeight="SemiBold" Visibility="{Binding StateVisibility}"/>
            </StackPanel>
            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0,4,0" IsEnabled="{Binding Available}">
              <CheckBox IsChecked="{Binding AudioOnly, Mode=TwoWay}" Content="{loc:T youtube.audio_only}" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,4"/>
              <ComboBox ItemsSource="{Binding RowChoices, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding OverrideChoice, Mode=TwoWay}" MinWidth="110" FlowDirection="LeftToRight" AutomationProperties.Name="{loc:T playlist.row_quality}" ToolTip="{loc:T playlist.row_quality}"/>
              <Border Visibility="{Binding OverrideVisibility}" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="6,1" Margin="0,4,0,0" HorizontalAlignment="Left"><TextBlock Text="{loc:T playlist.override}" FontSize="11" Foreground="{DynamicResource InkBrush}"/></Border>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="4" x:Name="FooterOptions" IsEnabled="False" Margin="0,10,0,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><Label Content="{loc:T youtube.folder}" Target="{Binding ElementName=Folder}" Padding="0,0,0,2"/><TextBox x:Name="Folder" FlowDirection="LeftToRight" TextChanged="Folder_Changed"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="12,0,0,0"><Label Content="{loc:T playlist.at_once}" Target="{Binding ElementName=AtOnce}" Padding="0,0,0,2"/><TextBox x:Name="AtOnce" Width="64" TextAlignment="Right" FlowDirection="LeftToRight" ToolTip="{loc:T playlist.at_once_tip}" AutomationProperties.Name="{loc:T playlist.at_once}"/></StackPanel>
      </Grid>
      <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><Label Content="{loc:T playlist.subfolder}" Target="{Binding ElementName=PackageName}" Padding="0,0,0,2"/><TextBox x:Name="PackageName" TextChanged="Package_Changed"/></StackPanel>
        <CheckBox x:Name="NumberBox" Grid.Column="1" Content="{loc:T playlist.numbering}" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Bottom" Margin="12,0,0,4"/>
      </Grid>
      <TextBlock x:Name="FinalFolder" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
      <StackPanel x:Name="SchedulePanel" Visibility="Collapsed" Margin="0,8,0,0">
        <Label Content="{loc:T schedule.label}" Target="{Binding ElementName=ScheduleInput}" Foreground="{DynamicResource InkBrush}" Padding="0,0,0,2"/><pstat:SchedulePicker x:Name="ScheduleInput"/>
      </StackPanel>
    </StackPanel>
    </Grid>
    </ScrollViewer>
    <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="CancelButton" Content="{loc:T common.btn.cancel}" IsCancel="True" Click="Cancel_Click" MinWidth="84" Margin="0,0,8,0"/>
      <Button x:Name="QueueButton" Content="{loc:T capture.btn.add_to_queue}" Click="Queue_Click" IsEnabled="False" MinWidth="100" Margin="0,0,8,0" ToolTipService.ShowOnDisabled="True"/>
      <Button x:Name="ScheduleButton" Content="{loc:T youtube.schedule}" Click="Schedule_Click" IsEnabled="False" MinWidth="84" Margin="0,0,8,0" ToolTipService.ShowOnDisabled="True"/>
      <Button x:Name="StartButton" Content="{loc:T youtube.download_now}" Click="Start_Click" IsEnabled="False" MinWidth="120" Style="{StaticResource PrimaryButton}" ToolTipService.ShowOnDisabled="True"/>
    </WrapPanel>
  </Grid>
</Window>
