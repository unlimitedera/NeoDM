<Window x:Class="NDM.App.DownloadCompleteWindow" Style="{StaticResource {x:Type Window}}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Download complete" Width="570" SizeToContent="Height" MinWidth="480" MinHeight="360" ResizeMode="CanResize" WindowStartupLocation="CenterOwner">
<Grid Margin="20,20,20,20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,16,0"><TextBlock Text="Download complete" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="FileNameLabel" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontWeight="SemiBold" Margin="0,14,0,6"/><TextBlock x:Name="SizeLabel" Style="{StaticResource Muted}"/><TextBox x:Name="PathLabel" IsReadOnly="True" TextWrapping="Wrap" Margin="0,10" AutomationProperties.Name="Saved file path"/><TextBlock Text="Only open files from sources you trust." Style="{StaticResource Muted}"/><TextBlock x:Name="Notice" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8" AutomationProperties.LiveSetting="Polite"/>
<WrapPanel><Button x:Name="OpenButton" Content="_Open…" Click="Open_Click" Margin="0,0,6,6"/><Button x:Name="OpenWithButton" Content="Open _with…" Click="OpenWith_Click" Margin="0,0,6,6"/><Button x:Name="FolderButton" Content="Open _folder" Click="Folder_Click" Margin="0,0,6,6"/><Button Content="Copy _path" Click="Copy_Click" Margin="0,0,6,6"/></WrapPanel>
<CheckBox x:Name="DontShowAgain" Content="Don't show completion dialogs again" Foreground="{DynamicResource InkBrush}" Margin="0,10" Checked="DontShowAgain_Changed" Unchecked="DontShowAgain_Changed"/><TextBlock Text="You can change this in Options → Downloads." Style="{StaticResource Muted}" FontSize="12"/></StackPanel></ScrollViewer>
<Button Grid.Row="1" Content="_Close" Click="Close_Click" HorizontalAlignment="Right" MinWidth="90" Margin="0,12,0,0" IsDefault="True"/></Grid>
</Window>
