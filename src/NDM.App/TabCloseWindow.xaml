<Window x:Class="NDM.App.TabCloseWindow" Style="{StaticResource {x:Type Window}}" Icon="Assets/NDM.ico" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:NDM.App.Localization" Title="{loc:T tabs.close_title}" Width="480" MinWidth="380" SizeToContent="Height" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBox x:Name="Message" Style="{StaticResource SelectableText}" TextWrapping="Wrap"/>
    <CheckBox x:Name="RememberBox" Grid.Row="1" Content="{loc:T tabs.close_remember}" Margin="0,16,0,0"/>
    <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="HideButton" Content="{loc:T tabs.close_hide}" Click="Hide_Click" MinWidth="96" Margin="0,0,8,6" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
      <Button x:Name="CancelDownloadButton" Content="{loc:T tabs.close_cancel}" Click="CancelDownload_Click" MinWidth="96" Margin="0,0,8,6"/>
      <Button x:Name="KeepButton" Content="{loc:T tabs.close_keep}" IsCancel="True" Click="Keep_Click" MinWidth="96" Margin="0,0,0,6"/>
    </WrapPanel>
  </Grid>
</Window>
