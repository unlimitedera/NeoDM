<Window x:Class="NDM.App.BulkImportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:NDM.App.Localization" Style="{StaticResource {x:Type Window}}" Icon="Assets/NDM.ico" Title="{loc:T bulk.title.import_urls}" Width="640" Height="650" MinWidth="500" MinHeight="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Closing="Window_Closing">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1.2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="{loc:T bulk.text.import_download_urls}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{loc:T bulk.text.one_http_s_url_per_line}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,12"/><Label Content="{loc:T bulk.label.download_urls}" Foreground="{DynamicResource InkBrush}" Target="{Binding ElementName=UrlsInput}"/></StackPanel>
    <TextBox Grid.Row="1" x:Name="UrlsInput" FlowDirection="LeftToRight" AcceptsReturn="True" VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:T bulk.a11y.one_download_url_per_line}"/>
    <TextBlock Grid.Row="2" x:Name="Summary" Text="{loc:T bulk.text.nothing_imported_yet}" TextWrapping="Wrap" Margin="0,12,0,8" AutomationProperties.LiveSetting="Polite"/>
    <ListBox Grid.Row="3" x:Name="Results" AutomationProperties.Name="{loc:T bulk.a11y.per_line_import_results}"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="8"/></DataTemplate></ListBox.ItemTemplate></ListBox>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button x:Name="CloseButton" Content="{loc:T bulk.btn.close}" IsCancel="True" Margin="0,0,8,0"/><Button x:Name="ImportButton" Content="{loc:T bulk.btn.import_valid_urls}" IsDefault="True" Click="Import_Click" Style="{StaticResource PrimaryButton}"/></StackPanel>
  </Grid>
</Window>
