<Window x:Class="NDM.App.TorrentAddWindow" Style="{StaticResource {x:Type Window}}" Icon="Assets/NDM.ico" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Add torrent" Width="680" Height="640" MinWidth="560" MinHeight="520" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="TitleText" Text="Add torrent" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      <TextBlock x:Name="SourceText" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,6,0,12" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </StackPanel>
    <Grid Grid.Row="1" x:Name="FetchPanel" Margin="0,0,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock x:Name="FetchText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <ProgressBar x:Name="FetchBar" IsIndeterminate="True" Height="6" Margin="0,6,0,0"/>
      </StackPanel>
      <Button x:Name="RetryButton" Grid.Column="1" Content="_Retry" Click="Retry_Click" Visibility="Collapsed" Margin="10,0,0,0"/>
    </Grid>
    <TreeView x:Name="FileTree" Grid.Row="2" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource InkBrush}" BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.Name="Torrent files">
      <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}"><Setter Property="IsExpanded" Value="True"/></Style></TreeView.ItemContainerStyle>
      <TreeView.ItemTemplate>
        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal" Margin="0,2">
            <CheckBox IsChecked="{Binding IsChecked}" IsThreeState="False" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding SizeText, StringFormat='  ({0})'}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
          </StackPanel>
        </HierarchicalDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
    <StackPanel Grid.Row="3" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal"><Button Content="Select _all" Click="SelectAll_Click" Margin="0,0,6,0"/><Button Content="Select _none" Click="SelectNone_Click" Margin="0,0,12,0"/><TextBlock x:Name="SelectionText" VerticalAlignment="Center"/></StackPanel>
      <Label Content="Save _to" Target="{Binding ElementName=SaveFolder}" Foreground="{DynamicResource InkBrush}" Padding="0,10,0,4"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SaveFolder" AutomationProperties.Name="Save folder"/><Button Grid.Column="1" Content="_Browse…" Click="Browse_Click" Margin="8,0,0,0"/></Grid>
      <TextBlock x:Name="SpaceText" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
    </StackPanel>
    <TextBlock Grid.Row="4" x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Assertive"/>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="84" Margin="0,0,8,0"/>
      <Button x:Name="PausedButton" Content="Add _paused" Click="AddPaused_Click" MinWidth="100" Margin="0,0,8,0" IsEnabled="False"/>
      <Button x:Name="StartButton" Content="_Start now" IsDefault="True" Click="StartNow_Click" Style="{StaticResource PrimaryButton}" MinWidth="100" IsEnabled="False"/>
    </StackPanel>
  </Grid>
</Window>
