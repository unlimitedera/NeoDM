<Window x:Class="NDM.App.UpdateWindow" Style="{StaticResource {x:Type Window}}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:NDM.App.Localization"
        Title="{loc:T update.title.neodm_update}" Icon="Assets/NDM.ico" Width="560" Height="560" MinWidth="480" MinHeight="420" WindowStartupLocation="CenterScreen" ShowInTaskbar="True" FontSize="13">
  <Grid Margin="24,20,24,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBox x:Name="HeadingText" Style="{StaticResource SelectableText}" FontSize="20" FontWeight="SemiBold"/>
      <TextBox x:Name="SubText" Style="{StaticResource SelectableMuted}" Margin="0,6,0,12"/>
      <TextBlock Text="{loc:T update.text.release_notes}" FontWeight="SemiBold" Margin="0,0,0,6"/>
    </StackPanel>
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
      <ScrollViewer x:Name="NotesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" AutomationProperties.Name="{loc:T update.text.release_notes}">
        <StackPanel x:Name="NotesPanel" FlowDirection="LeftToRight" Margin="14,10,14,12"/>
      </ScrollViewer>
    </Border>
    <TextBlock Grid.Row="2" Margin="0,10,0,0">
      <Hyperlink x:Name="ChangelogLink" Click="Changelog_Click"><Run Text="{loc:T update.link.view_full_changelog}"/></Hyperlink><Run Text="   "/><Hyperlink x:Name="ReleaseLink" Click="Release_Click"><Run Text="{loc:T update.link.release_page}"/></Hyperlink>
    </TextBlock>
    <StackPanel Grid.Row="3" Margin="0,12,0,0">
      <ProgressBar x:Name="DownloadBar" Maximum="100" Visibility="Collapsed" Height="6"/>
      <TextBox x:Name="StatusText" Style="{StaticResource SelectableText}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
    <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="SkipButton" Content="{loc:T update.btn.skip_this_version}" Click="Skip_Click" Margin="0,0,8,0"/>
      <Button x:Name="LaterButton" Content="{loc:T update.btn.remind_me_later}" Click="Later_Click" Margin="0,0,8,0" IsCancel="True"/>
      <Button x:Name="UpdateButton" Content="{loc:T update.btn.update_now}" Click="Update_Click" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="110"/>
    </WrapPanel>
  </Grid>
</Window>
