<Window x:Class="NDM.App.NeoBrowserWindow" Style="{StaticResource {x:Type Window}}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:NDM.App.Localization" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{loc:T neobrowser.title}" Width="1000" Height="700" MinWidth="340" MinHeight="260" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" FontSize="13">
  <Grid Margin="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
        <Button x:Name="BackButton" Content="{loc:T neobrowser.btn.back}" MinWidth="64" Margin="0,0,6,0" Click="Back_Click" IsEnabled="False" AutomationProperties.Name="{loc:T neobrowser.btn.back}"/>
        <Button x:Name="ForwardButton" Content="{loc:T neobrowser.btn.forward}" MinWidth="64" Margin="0,0,6,0" Click="Forward_Click" IsEnabled="False" AutomationProperties.Name="{loc:T neobrowser.btn.forward}"/>
        <Button x:Name="ReloadButton" Content="{loc:T neobrowser.btn.reload}" MinWidth="64" Margin="0,0,10,0" Click="Reload_Click" IsEnabled="False" AutomationProperties.Name="{loc:T neobrowser.btn.reload}"/>
      </StackPanel>
      <TextBox x:Name="AddressBox" IsReadOnly="True" FlowDirection="LeftToRight" VerticalContentAlignment="Center" MinHeight="30" Padding="8,3" AutomationProperties.Name="{loc:T neobrowser.a11y.address}"/>
    </DockPanel>
    <Grid Grid.Row="1">
      <wv2:WebView2 x:Name="Web" Visibility="Collapsed"/>
      <StackPanel x:Name="MissingPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
        <TextBlock x:Name="MissingText" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" AutomationProperties.LiveSetting="Polite"/>
        <Button x:Name="MissingLink" Content="{loc:T neobrowser.btn.get_runtime}" HorizontalAlignment="Left" MinWidth="170" Margin="0,12,0,0" Click="MissingLink_Click"/>
      </StackPanel>
    </Grid>
    <TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/>
  </Grid>
</Window>
