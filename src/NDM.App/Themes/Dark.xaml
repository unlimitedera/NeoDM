<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="CanvasBrush" Color="#171B1E"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="#1C2226"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#232A2F"/>
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#2C353B"/>
  <SolidColorBrush x:Key="InkBrush" Color="#F3F5F6"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#B0BDC6"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#3B464E"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#80D5C8"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#A2E5DB"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#264640"/>
  <SolidColorBrush x:Key="OnAccentBrush" Color="#102B27"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="#8ADCAB"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#F1C36A"/>
  <SolidColorBrush x:Key="ErrorBrush" Color="#FF9DA5"/>
  <SolidColorBrush x:Key="DisabledInkBrush" Color="#7F8C95"/>
  <SolidColorBrush x:Key="ThumbBrush" Color="#4E5B64"/>
  <SolidColorBrush x:Key="ThumbHoverBrush" Color="#6F808C"/>
  <SolidColorBrush x:Key="ThumbPressedBrush" Color="#93A5B1"/>
  <SolidColorBrush x:Key="AccentFillBrush" Color="#80D5C8"/>
  <SolidColorBrush x:Key="ItemHoverBrush" Color="#2C353B"/>
  <SolidColorBrush x:Key="ItemSelectedBrush" Color="#264640"/>
  <SolidColorBrush x:Key="ItemSelectedInactiveBrush" Color="#353F46"/>
  <SolidColorBrush x:Key="ItemSelectedForegroundBrush" Color="#F3F5F6"/>
  <!-- System colours follow the theme, so any control that still reads them (column headers, text selection, data grids) never shows the Windows default highlight. -->
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#264640"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F3F5F6"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#353F46"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F3F5F6"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#232A2F"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F3F5F6"/>
  <CornerRadius x:Key="ControlRadius">6</CornerRadius>
  <CornerRadius x:Key="CardRadius">8</CornerRadius>
  <Thickness x:Key="ControlPadding">14,9</Thickness>
  <Thickness x:Key="CommandPadding">10,5</Thickness>
  <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="CommandMinHeight">30</sys:Double>
</ResourceDictionary>