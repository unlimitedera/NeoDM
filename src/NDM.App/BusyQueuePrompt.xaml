<Window x:Class="NDM.App.BusyQueuePrompt" Style="{StaticResource {x:Type Window}}" Icon="Assets/NDM.ico" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:NDM.App.Localization" Title="{loc:T busy.title}" Width="480" MinWidth="360" SizeToContent="Height" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBox x:Name="Message" Style="{StaticResource SelectableText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <RadioButton x:Name="WaitRadio" Grid.Row="1" GroupName="busy" IsChecked="True" Content="{loc:T busy.wait}" Margin="0,0,0,6"/>
    <RadioButton x:Name="NowRadio" Grid.Row="2" GroupName="busy" Content="{loc:T busy.now}" Margin="0,0,0,12"/>
    <StackPanel Grid.Row="3" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal">
        <Label Content="{loc:T busy.count}" Target="{Binding ElementName=CountBox}" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
        <TextBox x:Name="CountBox" Width="56" FlowDirection="LeftToRight" TextAlignment="Right" Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="{loc:T busy.count}"/>
        <Button x:Name="ApplyButton" Content="{loc:T common.btn.apply}" Click="Apply_Click" MinWidth="80" Margin="8,0,0,0"/>
      </StackPanel>
      <TextBlock x:Name="CountError" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <CheckBox x:Name="RememberBox" Content="{loc:T busy.remember}" VerticalAlignment="Center"/>
      <Button x:Name="OkButton" Grid.Column="1" Content="{loc:T prompt.btn.ok}" IsDefault="True" Click="Ok_Click" MinWidth="96" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"/>
    </Grid>
  </Grid>
</Window>
