{
  "manifest_version": 3,
  "name": "__MSG_ext_name__",
  "default_locale": "en",
  "version": "1.5.9",
  "description": "__MSG_ext_description__",
  "key": "",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["nativeMessaging", "downloads", "contextMenus", "storage", "webRequest", "tabs", "cookies"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" },
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["i18n.js", "sniff.js", "content.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true, "match_origin_as_fallback": true },
    { "matches": ["http://*/*", "https://*/*"], "js": ["hooks.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true, "match_origin_as_fallback": true, "world": "MAIN" }
  ],
  "action": {
    "default_title": "__MSG_ext_action_title__",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  }
}
