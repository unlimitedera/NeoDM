<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="CanvasBrush" Color="#F4EEE3"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="#EBE3D4"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FBF8F1"/>
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F1EADB"/>
  <SolidColorBrush x:Key="InkBrush" Color="#2B2118"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#6B5B4A"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#D9CDB8"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#8A4B1F"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#6F3B16"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#EFDFC8"/>
  <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="#2F6B3A"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#8A5A00"/>
  <SolidColorBrush x:Key="ErrorBrush" Color="#A52A2A"/>
  <SolidColorBrush x:Key="DisabledInkBrush" Color="#85766A"/>
  <SolidColorBrush x:Key="ThumbBrush" Color="#CFC1A9"/>
  <SolidColorBrush x:Key="ThumbHoverBrush" Color="#B0A087"/>
  <SolidColorBrush x:Key="ThumbPressedBrush" Color="#8C7C63"/>
  <SolidColorBrush x:Key="AccentFillBrush" Color="#8A4B1F"/>
  <SolidColorBrush x:Key="ItemHoverBrush" Color="#F1EADB"/>
  <SolidColorBrush x:Key="ItemSelectedBrush" Color="#EFDFC8"/>
  <SolidColorBrush x:Key="ItemSelectedInactiveBrush" Color="#E3D9C6"/>
  <SolidColorBrush x:Key="ItemSelectedForegroundBrush" Color="#2B2118"/>
  <!-- System colours follow the theme, so any control that still reads them (column headers, text selection, data grids) never shows the Windows default highlight. -->
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#EFDFC8"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#2B2118"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E3D9C6"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#2B2118"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FBF8F1"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#2B2118"/>
  <CornerRadius x:Key="ControlRadius">6</CornerRadius>
  <CornerRadius x:Key="CardRadius">8</CornerRadius>
  <Thickness x:Key="ControlPadding">14,9</Thickness>
  <Thickness x:Key="CommandPadding">10,5</Thickness>
  <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="CommandMinHeight">30</sys:Double>
</ResourceDictionary>