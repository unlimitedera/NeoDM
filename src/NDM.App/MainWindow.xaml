<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:NDM.App.Localization" xmlns:local="clr-namespace:NDM.App" Style="{StaticResource {x:Type Window}}" x:Class="NDM.App.MainWindow" Typography.NumeralAlignment="Tabular" Icon="Assets/NDM.ico" Title="NeoDM" Width="1180" Height="720" MinWidth="900" MinHeight="480" FontSize="13" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Window.Resources>
    <Style x:Key="Command" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="{DynamicResource CommandPadding}"/>
      <Setter Property="MinHeight" Value="{DynamicResource CommandMinHeight}"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>
    <Style x:Key="StatusButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ItemHoverBrush}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.75"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SidebarCommand" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Padding" Value="6,5"/>
      <Setter Property="MinHeight" Value="{DynamicResource CommandMinHeight}"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
      <Setter Property="MinHeight" Value="30"/>
    </Style>
  </Window.Resources>
  <DockPanel>
    <Menu x:Name="MainMenu" DockPanel.Dock="Top" Padding="4,2" AutomationProperties.Name="{loc:T main.a11y.main_menu}">
      <MenuItem Header="{loc:T main.menu.tasks}">
        <MenuItem Header="{loc:T main.menu.add_url}" Click="Add_Click" InputGestureText="Ctrl+N"/>
        <MenuItem Header="{loc:T main.menu.import_urls}" Click="Bulk_Click"/>
        <MenuItem Header="{loc:T main.menu.link_grabber}" Click="Grabber_Click" InputGestureText="Ctrl+Shift+V"/>
        <MenuItem Header="{loc:T main.menu.add_torrent_file}" Click="AddTorrentFile_Click" Tag="torrent"/>
        <MenuItem Header="{loc:T main.menu.remove_completed}" Click="RemoveCompleted_Click"/>
        <MenuItem Header="{loc:T main.menu.scheduler}" Click="Schedule_Click" IsEnabled="{Binding IsEnabled, ElementName=ScheduleButton}"/>
      </MenuItem>
      <MenuItem Header="{loc:T main.menu.file}">
        <MenuItem Header="{loc:T main.menu.add_torrent_file}" Click="AddTorrentFile_Click" Tag="torrent"/>
        <MenuItem Header="{loc:T main.menu.open_file}" Click="Open_Click" IsEnabled="{Binding IsEnabled, ElementName=OpenButton}"/>
        <MenuItem Header="{loc:T common.btn.open_folder}" Click="Folder_Click" IsEnabled="{Binding IsEnabled, ElementName=FolderButton}"/>
        <MenuItem Header="{loc:T main.menu.e_xit}" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="{loc:T common.menu.downloads}">
        <MenuItem Header="{loc:T main.menu.resume}" Click="Resume_Click" IsEnabled="{Binding IsEnabled, ElementName=ResumeButton}"/>
        <MenuItem Header="{loc:T main.menu.stop}" Click="Stop_Click" IsEnabled="{Binding IsEnabled, ElementName=StopButton}"/>
        <MenuItem Header="{loc:T main.menu.stop_all}" Click="PauseAll_Click" IsEnabled="{Binding IsEnabled, ElementName=PauseAllButton}"/>
        <MenuItem Header="{loc:T main.menu.resume_all_paused}" Click="ResumeAll_Click" IsEnabled="{Binding IsEnabled, ElementName=ResumeAllButton}"/>
        <MenuItem x:Name="ProgressMenu" Header="{loc:T main.menu.progress}" Click="Progress_Click"/>
        <MenuItem Header="{loc:T main.menu.speed_limit}" Click="Speed_Click" IsEnabled="{Binding IsEnabled, ElementName=SpeedButton}"/>
        <MenuItem Header="{loc:T main.menu.remove}" Click="Remove_Click" IsEnabled="{Binding IsEnabled, ElementName=RemoveButton}"/>
        <Separator/>
        <MenuItem x:Name="FinishMenu" Header="{loc:T main.menu.when_downloads_finish}"/>
      </MenuItem>
      <MenuItem Header="{loc:T main.menu.view}">
        <MenuItem Header="{loc:T main.menu.all_downloads}" Click="ViewFilter_Click" Tag="All"/>
        <MenuItem Header="{loc:T main.menu.downloading}" Click="ViewFilter_Click" Tag="Downloading"/>
        <MenuItem Header="{loc:T main.menu.paused}" Click="ViewFilter_Click" Tag="Paused"/>
        <MenuItem Header="{loc:T main.menu.completed}" Click="ViewFilter_Click" Tag="Completed"/>
        <MenuItem Header="{loc:T main.menu.failed}" Click="ViewFilter_Click" Tag="Failed"/>
        <Separator Tag="torrent"/>
        <MenuItem Header="{loc:T main.menu.all_torrents}" Click="ViewFilter_Click" Tag="T:All"/>
        <MenuItem Header="{loc:T main.menu.torrents_downloading}" Click="ViewFilter_Click" Tag="T:Downloading"/>
        <MenuItem Header="{loc:T main.menu.torrents_seeding}" Click="ViewFilter_Click" Tag="T:Seeding"/>
        <MenuItem Header="{loc:T main.menu.torrents_completed}" Click="ViewFilter_Click" Tag="T:Completed"/>
        <Separator Tag="torrent"/>
        <MenuItem Header="{loc:T main.menu.find}" Click="Find_Click" InputGestureText="Ctrl+F"/>
        <MenuItem Header="{loc:T main.menu.refresh}" Click="Refresh_Click" InputGestureText="F5"/>
      </MenuItem>
      <MenuItem x:Name="OptionsMenuItem" Header="{loc:T main.menu.options}" Click="Settings_Click" AutomationProperties.Name="{loc:T common.a11y.options}"/>
      <MenuItem Header="{loc:T main.menu.help}">
        <MenuItem Header="{loc:T main.menu.keyboard_shortcuts}" Click="Help_Click"/>
        <MenuItem x:Name="ExtensionStoreMenuItem" Header="{loc:T main.menu.install_from_the_chrome_web_store}" Click="ExtensionStore_Click"/>
        <MenuItem x:Name="ExtensionGuideMenuItem" Header="{loc:T main.menu.browser_e_xtension_install_guide}" Click="ExtensionGuide_Click"/>
        <MenuItem x:Name="BridgeStatusMenuItem" Header="{loc:T main.menu.browser_connection}" Click="BridgeStatus_Click"/>
        <MenuItem Header="{loc:T main.menu.check_for_updates}" Click="CheckUpdates_Click"/>
        <MenuItem Header="{loc:T main.menu.about_neodm}" Click="About_Click"/>
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="8,7" Background="{DynamicResource SidebarBrush}">
      <WrapPanel>
        <Button Content="{loc:T main.btn.add_url}" Click="Add_Click" Style="{StaticResource Command}"/>
        <Button x:Name="AddTorrentButton" Content="{loc:T main.btn.add_torrent}" Click="AddTorrentFile_Click" Style="{StaticResource Command}"/>
        <Button x:Name="ResumeButton" Content="{loc:T main.btn.resume}" Click="Resume_Click" Style="{StaticResource Command}"/>
        <Button x:Name="StopButton" Content="{loc:T main.btn.stop}" Click="Stop_Click" Style="{StaticResource Command}"/>
        <Button x:Name="PauseAllButton" Content="{loc:T main.btn.stop_all}" Click="PauseAll_Click" Style="{StaticResource Command}"/>
        <Button x:Name="RemoveButton" Content="{loc:T main.btn.remove}" Click="Remove_Click" Style="{StaticResource Command}"/>
        <Button Content="{loc:T main.btn.remove_completed}" Click="RemoveCompleted_Click" Style="{StaticResource Command}"/>
        <Button Content="{loc:T main.btn.options}" Click="Settings_Click" Style="{StaticResource Command}"/>
        <Button x:Name="ScheduleButton" Content="{loc:T main.btn.scheduler}" Click="Schedule_Click" Style="{StaticResource Command}"/>
      </WrapPanel>
    </Border>
    <Border x:Name="StatusHost" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,6" SizeChanged="StatusHost_SizeChanged">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Notice" Text="{loc:T main.text.ready}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="DiskButton" Style="{StaticResource StatusButton}" Click="Disk_Click" PreviewKeyDown="Disk_KeyDown" AutomationProperties.Name="{loc:T disk.a11y}" ToolTipService.ShowDuration="30000" ToolTipService.InitialShowDelay="300">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" FlowDirection="LeftToRight"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconDisk}" Style="{StaticResource LineIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Canvas></Viewbox>
              <TextBlock x:Name="DiskText" Style="{StaticResource Muted}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              <ProgressBar x:Name="DiskBar" Width="64" Height="4" Margin="8,0,0,0" VerticalAlignment="Center" Minimum="0" Maximum="100" IsHitTestVisible="False" AutomationProperties.Name="{loc:T disk.a11y_bar}"/>
              <TextBlock x:Name="DiskActivityText" Style="{StaticResource Muted}" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" AutomationProperties.Name="{loc:T disk.a11y_activity}"/>
              <local:Sparkline x:Name="DiskSpark" Width="44" Height="14" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
          </Button>
          <TextBlock x:Name="Summary" Style="{StaticResource Muted}" Margin="12,0"/>
          <TextBlock x:Name="RateLabel" Style="{StaticResource Muted}"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" MinWidth="166" MaxWidth="260"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="8,12">
          <TextBlock DockPanel.Dock="Top" Text="{loc:T main.text.downloads}" FontSize="11" FontWeight="SemiBold" Style="{StaticResource Muted}" Margin="8,0,0,10"/>
          <StackPanel DockPanel.Dock="Bottom">
            <Button x:Name="GrabberButton" Content="{loc:T main.btn.link_grabber}" Click="Grabber_Click" Style="{StaticResource SidebarCommand}" local:NavIcon.Data="{StaticResource IconLinks}" ToolTip="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Button x:Name="BulkButton" Content="{loc:T main.btn.import_urls}" Click="Bulk_Click" Style="{StaticResource SidebarCommand}" local:NavIcon.Data="{StaticResource IconUpload}" ToolTip="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Button x:Name="ResumeAllButton" MinHeight="36" Content="{loc:T main.menu.resume_all_paused}" Click="ResumeAll_Click" Style="{StaticResource SidebarCommand}" local:NavIcon.Data="{StaticResource IconResume}" ToolTip="{Binding Content, RelativeSource={RelativeSource Self}}"/>
          </StackPanel>
          <local:NavListBox x:Name="Navigation" Style="{StaticResource {x:Type ListBox}}" SelectionChanged="FilterChanged" ItemContainerStyle="{StaticResource NavItem}" AutomationProperties.Name="{loc:T main.a11y.download_status_filters}">
            <local:NavTreeItem Tag="All" local:NavIcon.Data="{StaticResource IconDownloads}" IsSelected="True">
              <TextBlock Text="{loc:T main.text.all_downloads}"/>
            </local:NavTreeItem>
            <ListBoxItem Tag="Downloading" local:NavIcon.Data="{StaticResource IconDownloading}">
              <TextBlock Text="{loc:T main.text.downloading}"/>
            </ListBoxItem>
            <ListBoxItem Tag="Paused" local:NavIcon.Data="{StaticResource IconPaused}">
              <TextBlock Text="{loc:T main.text.paused}"/>
            </ListBoxItem>
            <ListBoxItem Tag="Completed" local:NavIcon.Data="{StaticResource IconCompleted}">
              <TextBlock Text="{loc:T main.text.completed}"/>
            </ListBoxItem>
            <ListBoxItem Tag="Failed" local:NavIcon.Data="{StaticResource IconFailed}">
              <TextBlock Text="{loc:T main.text.failed}"/>
            </ListBoxItem>
            <ListBoxItem Tag="Queued" local:NavIcon.Data="{StaticResource IconQueued}">
              <TextBlock Text="{loc:T main.text.queued}"/>
            </ListBoxItem>
            <ListBoxItem Tag="Scheduled" local:NavIcon.Data="{StaticResource IconScheduled}">
              <TextBlock Text="{loc:T main.text.scheduled}"/>
            </ListBoxItem>
            <ListBoxItem Tag="header" x:Name="TorrentsHeader" Focusable="False" IsHitTestVisible="False" AutomationProperties.Name="{loc:T main.a11y.torrents_section}">
              <TextBlock Text="{loc:T main.text.torrents}" FontSize="11" FontWeight="SemiBold" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
            </ListBoxItem>
            <ListBoxItem Tag="T:All" local:NavIcon.Data="{StaticResource IconMagnet}">
              <TextBlock Text="{loc:T main.text.all_torrents}"/>
            </ListBoxItem>
            <ListBoxItem Tag="T:Downloading" local:NavIcon.Data="{StaticResource IconDownloading}">
              <TextBlock Text="{loc:T main.text.downloading}"/>
            </ListBoxItem>
            <ListBoxItem Tag="T:Seeding" local:NavIcon.Data="{StaticResource IconSeeding}">
              <TextBlock Text="{loc:T common.text.seeding}"/>
            </ListBoxItem>
            <ListBoxItem Tag="T:Completed" local:NavIcon.Data="{StaticResource IconCompleted}">
              <TextBlock Text="{loc:T main.text.completed}"/>
            </ListBoxItem>
          </local:NavListBox>
        </DockPanel>
      </Border>
      <DockPanel Grid.Column="1" Margin="10,0,10,8">
        <Grid DockPanel.Dock="Top" Margin="0,9">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="230"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="Heading" Text="{loc:T main.text.all_downloads}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock x:Name="CountLabel" Grid.Column="1" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0"/>
          <TextBox x:Name="Search" Grid.Column="2" TextChanged="SearchChanged" MinHeight="30" Padding="8,4" ToolTip="{loc:T main.tip.search_file_names_or_urls_ctrl}" AutomationProperties.Name="{loc:T main.a11y.search_downloads}"/>
        </Grid>
        <Border DockPanel.Dock="Bottom" x:Name="DetailsPanel" Visibility="Collapsed" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="DetailName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <TextBlock x:Name="DetailPath" FlowDirection="LeftToRight" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              </StackPanel>
              <WrapPanel Grid.Column="1" Margin="10,0,0,0">
                <Button x:Name="PauseButton" Content="{loc:T common.btn.pause}" Click="Pause_Click" Style="{StaticResource Command}"/>
                <Button x:Name="SpeedButton" Content="{loc:T main.btn.speed_limit}" Click="Speed_Click" Style="{StaticResource Command}"/>
                <Button x:Name="OpenButton" Content="{loc:T main.btn.open_file}" Click="Open_Click" Style="{StaticResource Command}"/>
                <Button x:Name="FolderButton" Content="{loc:T main.btn.open_folder}" Click="Folder_Click" Style="{StaticResource Command}"/>
              </WrapPanel>
            </Grid>
            <TextBlock x:Name="DetailTorrent" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" Visibility="Collapsed"/>
            <TextBlock x:Name="DetailError" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" MaxHeight="60" Margin="0,5,0,0"/>
          </StackPanel>
        </Border>
        <Grid>
          <ListView x:Name="DownloadList" local:ListViewFill.FillColumn="0" local:ListViewFill.MinFillWidth="205" ItemsSource="{Binding Rows}" SelectionChanged="SelectionChanged" MouseDoubleClick="List_DoubleClick" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource InkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="{loc:T main.a11y.download_queue}">
            <ListView.ContextMenu>
              <ContextMenu>
                <MenuItem x:Name="CtxOpen" Header="{loc:T common.btn.open}" Click="ContextOpen_Click"/>
                <MenuItem x:Name="CtxOpenWith" Header="{loc:T common.btn.open_with}" Click="ContextOpenWith_Click"/>
                <MenuItem x:Name="CtxFolder" Header="{loc:T common.btn.open_folder}" Click="ContextFolder_Click"/>
                <Separator/>
                <MenuItem x:Name="CtxDownloadAsStream" Header="{loc:T stream.btn.download_as_stream}" Click="ContextDownloadAsStream_Click"/>
                <MenuItem x:Name="CtxOpenPage" Header="{loc:T wrongcontent.open_page}" Click="ContextOpenPage_Click"/>
                <MenuItem x:Name="CtxCopyUrl" Header="{loc:T main.menu.copy_url_address}" Click="ContextCopyUrl_Click"/>
                <MenuItem x:Name="CtxCopyPath" Header="{loc:T main.menu.copy_file_path}" Click="ContextCopyPath_Click"/>
                <MenuItem x:Name="CtxCopyError" Header="{loc:T main.menu.copy_error_message}" Click="ContextCopyError_Click"/>
                <MenuItem x:Name="CtxMagnet" Header="{loc:T main.menu.copy_magnet_link}" Click="ContextCopyMagnet_Click"/>
                <MenuItem x:Name="CtxMove" Header="{loc:T main.menu.move_rename}" Click="ContextMove_Click"/>
                <MenuItem x:Name="CtxProperties" Header="{loc:T main.menu.propert_ies}" Click="ContextProperties_Click"/>
                <MenuItem x:Name="CtxDetails" Header="{loc:T main.menu.torrent_details}" Click="ContextDetails_Click"/>
                <Separator/>
                <MenuItem x:Name="CtxResume" Header="{loc:T main.menu.resu_me}" Click="ContextResume_Click"/>
                <MenuItem x:Name="CtxStop" Header="{loc:T main.menu.s_top_pause}" Click="ContextStop_Click"/>
                <MenuItem x:Name="CtxRefreshUrl" Header="{loc:T main.menu.re_fresh_address}" Click="ContextRefreshUrl_Click"/>
                <MenuItem x:Name="CtxRedownload" Header="{loc:T main.menu.redo_wnload}" Click="ContextRedownload_Click"/>
                <Separator/>
                <MenuItem x:Name="CtxSpeed" Header="{loc:T main.menu.set_speed_limit}" Click="Speed_Click"/>
                <MenuItem x:Name="CtxSchedule" Header="{loc:T main.menu.sc_hedule}" Click="Schedule_Click"/>
                <Separator/>
                <MenuItem x:Name="CtxRemove" Header="{loc:T main.menu.remove}" Click="ContextRemove_Click" InputGestureText="Del"/>
                <MenuItem x:Name="CtxDelete" Header="{loc:T main.menu.delete_from_disk}" Click="ContextDelete_Click"/>
              </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
              <GridView AllowsColumnReorder="True">
                <GridViewColumn Width="205">
                  <GridViewColumn.Header>
                    <GridViewColumnHeader Content="{loc:T main.btn.filename}" Tag="FileName" Click="Sort_Click"/>
                  </GridViewColumn.Header>
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <DockPanel ToolTip="{Binding DisplayUrl}">
                        <Border DockPanel.Dock="Right" Margin="6,0,0,0" Padding="5,0" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Visibility="{Binding StreamBadgeVisibility}" VerticalAlignment="Center" ToolTip="{Binding StreamTip}"><TextBlock Text="{Binding StreamBadge}" Style="{StaticResource Muted}" FontSize="11"/></Border>
                        <local:FileTypeIcon DockPanel.Dock="Left" Extension="{Binding IconExtension}" Folder="{Binding IconFolder}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      </DockPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="68" DisplayMemberBinding="{Binding Size}">
                  <GridViewColumn.Header>
                    <GridViewColumnHeader Content="{loc:T common.btn.size}" Tag="TotalBytes" Click="Sort_Click"/>
                  </GridViewColumn.Header>
                </GridViewColumn>
                <GridViewColumn Width="140">
                  <GridViewColumn.Header>
                    <GridViewColumnHeader Content="{loc:T common.text.status}" Tag="Status" Click="Sort_Click"/>
                  </GridViewColumn.Header>
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock x:Name="StatusCell" Text="{Binding StatusDisplay}" ToolTip="{Binding StatusTip}" TextTrimming="CharacterEllipsis" MouseLeftButtonUp="StatusCell_Click">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusKind}" Value="Completed"><Setter Property="Foreground" Value="{DynamicResource StatusCompletedBrush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding StatusKind}" Value="Downloading"><Setter Property="Foreground" Value="{DynamicResource StatusDownloadingBrush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding StatusKind}" Value="Paused"><Setter Property="Foreground" Value="{DynamicResource StatusPausedBrush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding StatusKind}" Value="Failed"><Setter Property="Foreground" Value="{DynamicResource StatusFailedBrush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding StatusKind}" Value="Queued"><Setter Property="Foreground" Value="{DynamicResource StatusQueuedBrush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding StatusKind}" Value="Seeding"><Setter Property="Foreground" Value="{DynamicResource StatusSeedingBrush}"/></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding CanRetryFromStatus}" Value="True"><Setter TargetName="StatusCell" Property="Cursor" Value="Hand"/></DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="94">
                  <GridViewColumn.Header>
                    <GridViewColumnHeader Content="{loc:T common.btn.progress}" Tag="Progress" Click="Sort_Click"/>
                  </GridViewColumn.Header>
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <Grid Width="80">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="45"/>
                          <ColumnDefinition Width="35"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Value="{Binding DisplayProgress, Mode=OneWay}" Maximum="100" Height="5" VerticalAlignment="Center" ToolTip="{Binding Detail}" local:ProgressStatus.Kind="{Binding StatusKind}" local:ProgressStatus.Active="{Binding IsTransferring}" IsIndeterminate="{Binding IsUnknownTotal, Mode=OneWay}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Percent}" HorizontalAlignment="Right"/>
                      </Grid>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="76" DisplayMemberBinding="{Binding Remaining}">
                  <GridViewColumn.Header>
                    <GridViewColumnHeader Content="{loc:T main.btn.remaining}" Tag="RemainingTime" Click="Sort_Click"/>
                  </GridViewColumn.Header>
                </GridViewColumn>
                <GridViewColumn Width="72" DisplayMemberBinding="{Binding SpeedText}">
                  <GridViewColumn.Header>
                    <GridViewColumnHeader Content="{loc:T main.btn.speed}" Tag="Speed" Click="Sort_Click"/>
                  </GridViewColumn.Header>
                </GridViewColumn>
                <GridViewColumn x:Name="PackageColumn" Width="0" DisplayMemberBinding="{Binding PackageText}">
                  <GridViewColumn.Header>
                    <GridViewColumnHeader Content="{loc:T main.col.package}" Tag="Package" Click="Sort_Click"/>
                  </GridViewColumn.Header>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
          <Grid x:Name="EmptyState" Margin="20,38,20,20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Rectangle x:Name="DropZoneFrame" RadiusX="14" RadiusY="14" StrokeThickness="2" StrokeDashArray="5 4" Stroke="{DynamicResource BorderBrush}" Fill="Transparent" IsHitTestVisible="False" SnapsToDevicePixels="True"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Margin="18,14">
                <Viewbox x:Name="EmptyIcon" Width="38" Height="38" Margin="0,0,0,8" FlowDirection="LeftToRight"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconDownloads}" Style="{StaticResource LineIcon}" Stroke="{DynamicResource MutedBrush}"/></Canvas></Viewbox>
                <TextBlock x:Name="EmptyHeading" Text="{loc:T main.text.no_downloads}" FontSize="16" FontWeight="SemiBold" TextAlignment="Center"/>
                <TextBlock x:Name="EmptyBody" Text="{loc:T main.empty.none_body}" Style="{StaticResource Muted}" Margin="0,6,0,14" TextAlignment="Center" TextWrapping="Wrap"/>
                <WrapPanel x:Name="EmptyButtons" HorizontalAlignment="Center">
                  <Button x:Name="EmptyAddUrl" Content="{loc:T main.btn.add_url}" Click="Add_Click" Style="{StaticResource PrimaryButton}" Margin="4,0,4,6"/>
                  <Button x:Name="EmptyAddTorrent" Content="{loc:T main.btn.add_torrent}" Click="AddTorrentFile_Click" Margin="4,0,4,6"/>
                  <Button x:Name="EmptyGrabber" Content="{loc:T main.btn.link_grabber}" Click="Grabber_Click" Margin="4,0,4,6"/>
                </WrapPanel>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
