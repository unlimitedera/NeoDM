<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="CanvasBrush" Color="#0F1A15"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="#13211A"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#182A21"/>
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#21392D"/>
  <SolidColorBrush x:Key="InkBrush" Color="#EAF5EE"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#A4BDAE"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#2F4A3B"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#6EE7B7"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#9CF0CF"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#1D4535"/>
  <SolidColorBrush x:Key="OnAccentBrush" Color="#06241A"/>
  <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#6EE7B7"/>
  <SolidColorBrush x:Key="SelectionForegroundBrush" Color="#06241A"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="#8CE3A9"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#EFC770"/>
  <SolidColorBrush x:Key="ErrorBrush" Color="#FF9FA0"/>
  <SolidColorBrush x:Key="DisabledInkBrush" Color="#80998A"/>
  <SolidColorBrush x:Key="ThumbBrush" Color="#38564A"/>
  <SolidColorBrush x:Key="ThumbHoverBrush" Color="#527A66"/>
  <SolidColorBrush x:Key="ThumbPressedBrush" Color="#76A18C"/>
  <SolidColorBrush x:Key="AccentFillBrush" Color="#6EE7B7"/>
  <SolidColorBrush x:Key="ItemHoverBrush" Color="#21392D"/>
  <SolidColorBrush x:Key="ItemSelectedBrush" Color="#1D4535"/>
  <SolidColorBrush x:Key="ItemSelectedInactiveBrush" Color="#294335"/>
  <SolidColorBrush x:Key="ItemSelectedForegroundBrush" Color="#EAF5EE"/>
  <!-- Status column text per state; every colour reads at 5:1 or better on the canvas, sidebar, row, hover and both selected-row backgrounds of this theme. -->
  <SolidColorBrush x:Key="StatusCompletedBrush" Color="#30CF6A"/>
  <SolidColorBrush x:Key="StatusDownloadingBrush" Color="#8BB5E4"/>
  <SolidColorBrush x:Key="StatusPausedBrush" Color="#D7AC56"/>
  <SolidColorBrush x:Key="StatusFailedBrush" Color="#E9A0A5"/>
  <SolidColorBrush x:Key="StatusQueuedBrush" Color="#A6B3C4"/>
  <SolidColorBrush x:Key="StatusSeedingBrush" Color="#2FCAA4"/>
  <!-- System colours follow the theme, so any control that still reads them (column headers, text selection, data grids) never shows the Windows default highlight. -->
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1D4535"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#EAF5EE"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#294335"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#EAF5EE"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#182A21"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#EAF5EE"/>
  <CornerRadius x:Key="ControlRadius">6</CornerRadius>
  <CornerRadius x:Key="ButtonRadius">6</CornerRadius>
  <CornerRadius x:Key="CardRadius">8</CornerRadius>
  <Thickness x:Key="ControlPadding">14,9</Thickness>
  <Thickness x:Key="CommandPadding">10,5</Thickness>
  <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="CommandMinHeight">30</sys:Double>
</ResourceDictionary>