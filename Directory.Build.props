<Project>
  <!-- Single source of truth for the product version (see docs/VERSIONING.md). Used by the app, the native host,
       the installer (build-installer.ps1) and the extension manifest (synced by build.ps1). -->
  <PropertyGroup>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <InformationalVersion>2.0.0</InformationalVersion>
    <IncludeSourceRevisionInformation>false</IncludeSourceRevisionInformation>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
