<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="CanvasBrush" Color="#F3F4F6"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="#EBEDF0"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F2F5F7"/>
  <SolidColorBrush x:Key="InkBrush" Color="#182127"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#59656E"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#D8DEE3"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#006C67"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#005954"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#DCEFEB"/>
  <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#006C67"/>
  <SolidColorBrush x:Key="SelectionForegroundBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="#19733F"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#8D5E00"/>
  <SolidColorBrush x:Key="ErrorBrush" Color="#B42332"/>
  <SolidColorBrush x:Key="DisabledInkBrush" Color="#757F87"/>
  <SolidColorBrush x:Key="ThumbBrush" Color="#BBC4CB"/>
  <SolidColorBrush x:Key="ThumbHoverBrush" Color="#939FA8"/>
  <SolidColorBrush x:Key="ThumbPressedBrush" Color="#6C7983"/>
  <SolidColorBrush x:Key="AccentFillBrush" Color="#006C67"/>
  <SolidColorBrush x:Key="ItemHoverBrush" Color="#F2F5F7"/>
  <SolidColorBrush x:Key="ItemSelectedBrush" Color="#DCEFEB"/>
  <SolidColorBrush x:Key="ItemSelectedInactiveBrush" Color="#E2E7EB"/>
  <SolidColorBrush x:Key="ItemSelectedForegroundBrush" Color="#182127"/>
  <!-- System colours follow the theme, so any control that still reads them (column headers, text selection, data grids) never shows the Windows default highlight. -->
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#DCEFEB"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#182127"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E2E7EB"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#182127"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#182127"/>
  <CornerRadius x:Key="ControlRadius">6</CornerRadius>
  <CornerRadius x:Key="CardRadius">8</CornerRadius>
  <Thickness x:Key="ControlPadding">14,9</Thickness>
  <Thickness x:Key="CommandPadding">10,5</Thickness>
  <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="CommandMinHeight">30</sys:Double>
</ResourceDictionary>