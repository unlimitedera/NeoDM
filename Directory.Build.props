<Project>
  <!-- Single source of truth for the product version (see docs/VERSIONING.md). Used by the app, the native host,
       the installer (build-installer.ps1) and the extension manifest (synced by build.ps1). -->
  <PropertyGroup>
    <Version>1.5.9</Version>
    <AssemblyVersion>1.5.9.0</AssemblyVersion>
    <FileVersion>1.5.9.0</FileVersion>
    <InformationalVersion>1.5.9</InformationalVersion>
    <IncludeSourceRevisionInformation>false</IncludeSourceRevisionInformation>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
