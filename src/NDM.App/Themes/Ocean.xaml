<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="CanvasBrush" Color="#0B1622"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="#0F1D2C"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#132436"/>
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#1B3249"/>
  <SolidColorBrush x:Key="InkBrush" Color="#EAF4FB"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#A3BBCE"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#27425B"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#3CC8F0"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#7ADCF7"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#12384C"/>
  <SolidColorBrush x:Key="OnAccentBrush" Color="#04202C"/>
  <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#3CC8F0"/>
  <SolidColorBrush x:Key="SelectionForegroundBrush" Color="#04202C"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="#6EDCA0"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#F2C46B"/>
  <SolidColorBrush x:Key="ErrorBrush" Color="#FF9CA6"/>
  <SolidColorBrush x:Key="DisabledInkBrush" Color="#7C95AA"/>
  <SolidColorBrush x:Key="ThumbBrush" Color="#2F4C66"/>
  <SolidColorBrush x:Key="ThumbHoverBrush" Color="#4A6D8A"/>
  <SolidColorBrush x:Key="ThumbPressedBrush" Color="#6E92B0"/>
  <SolidColorBrush x:Key="AccentFillBrush" Color="#3CC8F0"/>
  <SolidColorBrush x:Key="ItemHoverBrush" Color="#1B3249"/>
  <SolidColorBrush x:Key="ItemSelectedBrush" Color="#12384C"/>
  <SolidColorBrush x:Key="ItemSelectedInactiveBrush" Color="#223C54"/>
  <SolidColorBrush x:Key="ItemSelectedForegroundBrush" Color="#EAF4FB"/>
  <!-- System colours follow the theme, so any control that still reads them (column headers, text selection, data grids) never shows the Windows default highlight. -->
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#12384C"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#EAF4FB"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#223C54"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#EAF4FB"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#132436"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#EAF4FB"/>
  <CornerRadius x:Key="ControlRadius">6</CornerRadius>
  <CornerRadius x:Key="CardRadius">8</CornerRadius>
  <Thickness x:Key="ControlPadding">14,9</Thickness>
  <Thickness x:Key="CommandPadding">10,5</Thickness>
  <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="CommandMinHeight">30</sys:Double>
</ResourceDictionary>