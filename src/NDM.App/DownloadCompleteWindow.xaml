<Window x:Class="NDM.App.DownloadCompleteWindow" Style="{StaticResource {x:Type Window}}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:NDM.App.Localization" Title="{loc:T complete.title.download_complete}" Width="570" SizeToContent="Height" MinWidth="480" MinHeight="360" ResizeMode="CanResize" WindowStartupLocation="CenterOwner">
<Grid Margin="20,20,20,20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,16,0"><TextBlock Text="{loc:T complete.title.download_complete}" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="FileNameLabel" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontWeight="SemiBold" Margin="0,14,0,6"/><TextBlock x:Name="SizeLabel" Style="{StaticResource Muted}"/><TextBox x:Name="PathLabel" FlowDirection="LeftToRight" IsReadOnly="True" TextWrapping="Wrap" Margin="0,10" AutomationProperties.Name="{loc:T complete.a11y.saved_file_path}"/><TextBlock Text="{loc:T complete.text.only_open_files_from_sources_you}" Style="{StaticResource Muted}"/><TextBlock x:Name="Notice" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8" AutomationProperties.LiveSetting="Polite"/>
<WrapPanel><Button x:Name="OpenButton" Content="{loc:T complete.btn.open}" Click="Open_Click" Margin="0,0,6,6"/><Button x:Name="OpenWithButton" Content="{loc:T common.btn.open_with}" Click="OpenWith_Click" Margin="0,0,6,6"/><Button x:Name="FolderButton" Content="{loc:T common.btn.open_folder}" Click="Folder_Click" Margin="0,0,6,6"/><Button Content="{loc:T complete.btn.copy_path}" Click="Copy_Click" Margin="0,0,6,6"/></WrapPanel>
<CheckBox x:Name="DontShowAgain" Content="{loc:T complete.chk.dont_show_completion_dialogs_again}" Foreground="{DynamicResource InkBrush}" Margin="0,10" Checked="DontShowAgain_Changed" Unchecked="DontShowAgain_Changed"/><TextBlock Text="{loc:T complete.text.you_can_change_this_in_options}" Style="{StaticResource Muted}" FontSize="12"/></StackPanel></ScrollViewer>
<Button Grid.Row="1" Content="{loc:T common.btn.close}" Click="Close_Click" HorizontalAlignment="Right" MinWidth="90" Margin="0,12,0,0" IsDefault="True"/></Grid>
</Window>
