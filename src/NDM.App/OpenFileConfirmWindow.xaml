<Window x:Class="NDM.App.OpenFileConfirmWindow" Style="{StaticResource {x:Type Window}}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:NDM.App.Localization"
        Title="{loc:T complete.confirm_open_title}" Width="500" SizeToContent="Height" MinWidth="380" MinHeight="300" MaxHeight="600" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13">
  <Border Padding="24,22,24,20">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="64"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="Heading" Text="{loc:T complete.confirm_open_title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <TextBox x:Name="MessageText" Style="{StaticResource SelectableText}" Margin="0,0,16,0" AutomationProperties.Name="{loc:T openfile.a11y.question}"/>
      </ScrollViewer>
      <CheckBox x:Name="DontAskBox" Grid.Row="2" Margin="0,14,0,0" MinHeight="26" Foreground="{DynamicResource InkBrush}" VerticalContentAlignment="Center" Visibility="Collapsed"/>
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button x:Name="YesButton" Content="{loc:T openfile.btn.yes}" MinWidth="96" MinHeight="32" Margin="0,0,8,0" Click="Yes_Click"/>
        <Button x:Name="NoButton" Content="{loc:T openfile.btn.no}" MinWidth="96" MinHeight="32" Style="{StaticResource PrimaryButton}" IsDefault="True" IsCancel="True" Click="No_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
