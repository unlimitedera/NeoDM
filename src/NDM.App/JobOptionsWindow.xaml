<Window x:Class="NDM.App.JobOptionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:NDM.App.Localization" Style="{StaticResource {x:Type Window}}" Icon="Assets/NDM.ico" Width="540" Height="360" MinWidth="480" MinHeight="340" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,16,0"><TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="Help" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,16"/><Label x:Name="InputLabel" Foreground="{DynamicResource InkBrush}" Target="{Binding ElementName=ValueInput}"/><TextBox x:Name="ValueInput" FlowDirection="LeftToRight"/><TextBlock x:Name="ValidationError" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive"/></StackPanel></ScrollViewer>
    <StackPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="StartNowButton" Content="{loc:T joboptions.btn.start_now}" Click="StartNow_Click" Margin="0,0,8,0"/><Button Content="{loc:T common.btn.cancel}" IsCancel="True" Margin="0,0,8,0"/><Button x:Name="ApplyButton" Content="{loc:T common.btn.apply}" IsDefault="True" Click="Apply_Click" Style="{StaticResource PrimaryButton}"/></StackPanel>
  </Grid>
</Window>
